---
// /personagens - catálogo completo. Os blocos são grupos editoriais do elenco;
// a partida usa apenas Time E e Time B.
import Layout from '../layouts/Layout.astro';
import { GRUPOS, PERSONAGENS, capaDoGrupo } from '../data/jogo';
import { BRAND_FULL, GAME_ID, abs } from '../lib/site';

const grupos = GRUPOS.map(g => ({ ...g, elenco: PERSONAGENS.filter(p => p.grupo === g.id) }));
const total = PERSONAGENS.length;

const placa = capaDoGrupo;
const slug = (nome: string) =>
  nome.normalize('NFD').replace(/[\u0300-\u036f]/g, '')
    .toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

const jsonld = [
  {
    '@type': 'ItemList',
    '@id': abs('/personagens') + '#lista',
    name: `Personagens do ${BRAND_FULL}`,
    description: `Os ${total} personagens do catálogo, divididos em ${GRUPOS.length} grupos editoriais. Elenco de sátira brasileira, folclore e caricaturas políticas.`,
    numberOfItems: total,
    itemListElement: PERSONAGENS.map((p, i) => ({
      '@type': 'ListItem', position: i + 1, name: p.nome,
      item: { '@type': 'Person', name: p.nome, description: p.blurb,
              additionalType: 'https://schema.org/FictionalCharacter' },
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'Personagens', item: abs('/personagens') },
    ],
  },
  { '@id': GAME_ID },
];
---
<Layout
  {/* og:image própria, gerada em runtime por /api/og/personagens.png (issue #33) -
      antes caía na og-image.png genérica, igual pra todo o site. */}
  ogImage={abs('/api/og/personagens.png')}
  ogImageAlt={`Card com o elenco do ${BRAND_FULL}`}
  title={`Personagens - os ${total} do elenco | ${BRAND_FULL}`}
  description={`Conheça o elenco do ${BRAND_FULL}: ${GRUPOS.map(g => g.nome).join(', ')}. As partidas usam somente Time E e Time B.`}
  jsonld={jsonld}
  h1="Personagens"
  kicker={`${total} personagens · ${GRUPOS.length} grupos`}
  heroImg={placa('palhacos')}
  heroPos="64%">
  <Fragment slot="sub">
    {total} personagens em {GRUPOS.length} grupos do catálogo. Esses grupos organizam o elenco, mas a partida
    usa somente Time E e Time B. Escolha no menu um personagem disponível para o seu time.
  </Fragment>

  {/* Índice em números: cada bloco abre um grupo editorial do elenco. */}
  <nav class="tstat" aria-label="Grupos do elenco">
    {grupos.map(g => (
      <a href={`#${slug(g.nome)}`} style={`--fc:${g.cor}`}>
        <b style={`color:${g.cor}`}>{g.elenco.length}</b><span>{g.nome}</span>
      </a>
    ))}
  </nav>

  {grupos.map((g, i) => (
    <section class="grupo" style={`--fc:${g.cor}`}>
      {/* PLACA EM RETRATO, e não faixa larga. As placas são 640×1601 (0,4:1):
          num bloco largo e baixo o `cover` amplia 1,6× e sobra um close de olho
          e boca. Em 210×230 o recorte mostra o time inteiro da cintura pra
          cima - que é o enquadramento da tela 02 do jogo. */}
      <header class="fhead">
        {placa(g.id) && (
          <div class="fplate">
            <img src={placa(g.id)} width="640" height="1601" loading="lazy" decoding="async"
                 alt={`Personagens do grupo ${g.nome} no ${BRAND_FULL}`}>
          </div>
        )}
        <div class="fmeta">
          <p class="meta"><b>Grupo {String(i + 1).padStart(2, '0')}</b><i>·</i>
            {g.elenco.length} personagens</p>
          <h2 id={slug(g.nome)} style={`color:${g.cor}`}>
            {/* O título abre o recorte próprio do grupo. */}
            <a href={`/grupos/${g.id}`} style={`color:${g.cor};text-decoration:none`}>{g.nome}</a>
          </h2>
          <p class="fmotto">“{g.lema}”</p>
          <p class="fnota">{g.nota}</p>
          <p style="margin-top:8px;font-size:12px">
            <a href={`/grupos/${g.id}`}>Página do grupo {g.nome} →</a>
          </p>
        </div>
      </header>
      <div class="grid roster">
        {g.elenco.map(p => (
          <article class="pcard">
            {p.id && <img class="pfoto" src={`/img/chars/avatars/${p.id}.webp`} width="256" height="256"
              loading="lazy" decoding="async" alt={`${p.nome} - personagem do ${BRAND_FULL}`} />}
            <strong>{p.nome}</strong>
            <p>{p.blurb}</p>
          </article>
        ))}
      </div>
    </section>
  ))}

  <h2>Sobre o elenco</h2>
  <p>
    O elenco mistura arquétipos satíricos, cultura urbana, personagens do folclore e da história brasileira e caricaturas de figuras políticas públicas. A disponibilidade de cada personagem aparece no menu do jogo.
  </p>

  <div class="cta-row">
    <a class="btn-cta" href="/">▶ Escolher o seu</a>
    <a class="btn-cta btn-2" href="/mapas">Ver as arenas</a>
  </div>
</Layout>



<style>
  /* ---- grupo: key art + identificação editorial ---- */
  .grupo{margin:44px 0 0}
  .fhead{display:flex;overflow:hidden;background:var(--panel-2);
    border:1px solid var(--line);border-left:3px solid var(--fc)}
  .fplate{flex:0 0 220px;position:relative;overflow:hidden;background:#0d0c07;
    min-height:206px;border-right:1px solid var(--line)}
  .fplate img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;
    object-position:50% 72%;filter:saturate(.95) contrast(1.04) brightness(.88)}
  /* dissolve a placa na borda direita, pra ela não virar um adesivo colado */
  .fplate:after{content:"";position:absolute;inset:0;background:
    linear-gradient(90deg,transparent 58%,rgba(24,21,13,.85) 100%),
    linear-gradient(0deg,rgba(10,10,8,.5) 0%,transparent 34%)}
  .fmeta{flex:1;padding:20px 24px;display:flex;flex-direction:column;justify-content:center;gap:5px}
  .fmeta h2{border:0;padding:0;margin:2px 0;font-size:22px;letter-spacing:3px;
    scroll-margin-top:calc(var(--topo) + 14px)}
  .fmotto{margin:0;color:var(--bone);font-size:13px;font-style:italic}
  .fnota{margin:8px 0 0;font-size:13px;max-width:62ch}

  /* ---- elenco ---- */
  .grid.roster{grid-template-columns:repeat(auto-fill,minmax(238px,1fr));margin-top:12px}
  .pcard{background:var(--panel);border:1px solid var(--line);border-left:3px solid var(--fc);
    padding:12px 14px;transition:border-color .14s,background .14s}
  .pcard:hover{background:var(--panel-2);border-color:var(--line-hi);border-left-color:var(--fc)}
  .pcard strong{color:var(--ink);letter-spacing:1px;font-size:13px;display:block}
  .pcard p{margin-top:5px;font-size:12.5px;line-height:1.55}

  /* o índice de números vira link, sem virar sublinhado */
  .tstat a{text-decoration:none;display:block;border:1px solid var(--line);
    background:var(--panel);padding:10px 12px;transition:border-color .14s,background .14s}
  .tstat a:hover{border-color:var(--fc);background:var(--panel-2)}

  @media (max-width:860px){
    .grupo{margin-top:32px}
    /* a placa continua em RETRATO, só estreita: virar faixa aqui traria de volta
       o close de olho e boca que motivou este desenho. */
    .fplate{flex:0 0 108px;min-height:0}
    .fmeta{padding:14px 16px}
    .fmeta h2{font-size:17px;letter-spacing:2px}
    .grid.roster{grid-template-columns:1fr}
  }
  .pcard{text-align:center}
  .pfoto{width:100%;height:auto;max-width:180px;aspect-ratio:1;object-fit:cover;object-position:center;
    border-radius:6px;border:1px solid var(--line-2,#333);margin:0 auto 8px;display:block;
    background:#1c1a20}
</style>
