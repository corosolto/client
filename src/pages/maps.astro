---
// /maps - GÊMEA EM INGLÊS do /mapas (mesmo desenho de /characters, gêmea do
// /personagens). Mesmo dataset (src/data/jogo.ts); nomes/resumos/detalhes
// traduzidos AQUI por overlay - o PT continua a fonte. Expressões de sabor
// (quebrada, baile, paredão, boteco, adega) ficam em PT, como em /characters.
// Redirecionamento por idioma: cada página manda pro par quando o idioma
// resolvido não bate (mesmas regras do public/js/i18n.js).
import Layout from '../layouts/Layout.astro';
import { MAPAS } from '../data/jogo';
import { BRAND_FULL, GAME_ID, abs } from '../lib/site';

const MAP_EN: Record<string, { nome: string; resumo: string; detalhe: string }> = {
  /* `mansao` e `campomorro` saíram da vitrine: estão PARADOS para retrabalho e
     fora do menu. O registro jogável vive em public/js/maps.js (MAPAS_PARADOS). */
  praca_poderes: {
    nome: 'Three Powers Plaza',
    resumo: 'The main arena: a fictional Brasília with a giant cracked voting machine in the middle.',
    detalhe: 'A reinterpretation of CS 1.6’s praca_poderes, Brasília edition. Two tall platforms face each ' +
      'other, and mid is dominated by a giant cracked electronic voting machine that works as central ' +
      'cover. Around it: a boteco, a pastel stand, a protest camp and the silhouette of Congress on ' +
      'the horizon. This is the map where the AWP rules - long angles, short cover, and nowhere ' +
      'truly safe.',
  },
  piscina_treta: {
    nome: 'Fight Pool',
    resumo: 'Indoor hall with a pool in the middle - the Brazilian piscina_treta.',
    detalhe: 'Indoor arena, no sky, with the sunken pool splitting the map into two levels. ' +
      'Close, vertical combat: whoever controls the edge controls the round. ' +
      'It’s where the shotgun and the SMGs finally beat the AWP.',
  },
  upa_24h: {
    nome: 'UPA 24h Emergency Clinic',
    resumo: 'An indoor emergency clinic with six clinical sections connected by corridors and twelve internal passages.',
    detalhe: 'Reception, triage, consultation rooms, observation, emergency care and pharmacy divide the arena. ' +
      'Stretchers, privacy screens and counters provide cover; colored floor markings guide you to each section. ' +
      'Three flags contest reception, the corridor and emergency care. Opens in Capture the Flag, ' +
      'with rounds also available in the menu.',
  },
  loja_h: {
    nome: 'H Store (Parking Lot)',
    resumo: 'Megastore parking lot with a statue, shopping carts and cars re-drawn every match.',
    detalhe: 'Asphalt and concrete, with rows of cars that CHANGE every match ' +
      '(the selection is seeded at random), so cover is never the same twice. ' +
      'Opens in Capture the Flag because the geometry was designed around the flags - ' +
      'but you can switch to rounds in the menu.',
  },
  ferro_velho: {
    nome: 'Zé’s Junkyard',
    resumo: 'A junkyard at sunset, with the stacked-car canyon of the WEST ALLEY.',
    detalhe: 'Piles of cars form real walls. The west flank is the WEST ALLEY: a straight canyon ' +
      'of double car walls, with two side exits into the core and a hanging sign at the south mouth. ' +
      'Low, warm light, long shadows. Four flags, all reachable from both spawns.',
  },
  quebrada: {
    nome: 'Quebrada (Baile Street)',
    resumo: 'A long straight outskirts street, with the baile rotunda at one end and the dirt pitch at the other.',
    detalhe: 'The newest map, and the only one that’s a STREET: asphalt down the axis, sidewalk on ' +
      'both sides, shacks and quebrada shops around - adega, açaí, ice cream parlor, diner, furniture. ' +
      'At one end the baile square, with tuned cars and a paredão of speakers; at the other, the ' +
      'dirt pitch. In between: a parked bus with a bus stop, a bar with plastic chairs on the ' +
      'sidewalk and barricades. The two back alleys aren’t decoration - they’re the alternate route ' +
      'that keeps the street from becoming a sniper corridor. Four flags: dirt pitch, corner bar, ' +
      'bus stop and baile square.',
  },
  lajes: {
    nome: 'Lajes (Community)',
    resumo: 'Narrow alleys between masonry homes, an open central field and rooftop combat.',
    detalhe: 'Both teams start at ground level. Three routes between the homes connect the spawns, ' +
      'with the central field as the only wide opening on the ground. Four stairways lead to two ' +
      'upper crossings lined with water tanks, parapets and clotheslines. Four rooftop flags reward ' +
      'the longer view, but getting there means contesting the stairs and their cover.',
  },
  "amazonia": {"nome": "Fight in the Amazon", "resumo": "An arena in the Amazon forest, with buildings and vegetation around the combat routes.", "detalhe": "Opens in Capture the Flag. You can also choose rounds from the menu before playing."},
  "escadao": {"nome": "Hillside Stairways", "resumo": "A hillside community with stairways, homes and combat across different levels.", "detalhe": "Opens in Capture the Flag. You can also choose rounds from the menu before playing."},
  "corrego": {"nome": "São Paulo Creek", "resumo": "A São Paulo favela built around a creek.", "detalhe": "Opens in Capture the Flag. You can also choose rounds from the menu before playing."},
  "posto_treta": {"nome": "Fight Gas Station", "resumo": "A roadside gas station with pumps, a canopy and a shop.", "detalhe": "Opens in Capture the Flag. You can also choose rounds from the menu before playing."},
  "velho_oeste": {"nome": "Sertão da Treta", "resumo": "A sertão arena with buildings and a caatinga landscape.", "detalhe": "Opens in Capture the Flag. You can also choose rounds from the menu before playing."},
  invasao_javaporcos: {
    nome: 'Invaded Town',
    resumo: 'Defend a Brazilian town from boars arriving through the surrounding forest.',
    detalhe: 'Reclaim occupied sectors, protect the food shops and use interiors and rooftops as refuges.',
  },
  distrito_rural: {
    nome: 'Rural District',
    resumo: 'Dirt roads, open barns, silos and food stores beside the forest.',
    detalhe: 'Hunt the invading boars across a rural district with several forest entrances and elevated refuges.',
  },
  vila_da_mata: {
    nome: 'Forest Village',
    resumo: 'Portuguese-inspired houses, a village square and shops on a forest hillside.',
    detalhe: 'Defend the village and reclaim its food stores, using upstairs windows and rooftops for shelter.',
  },
};
const en = (id: string) => MAP_EN[id];

const nCtf = MAPAS.filter(m => m.ctf).length;
const nRounds = MAPAS.length - nCtf;
const CTF_NOMES = MAPAS.filter(m => m.ctf).map(m => en(m.id).nome);
const plural = (n: number, um: string, muitos: string) => (n === 1 ? um : muitos);

/* Mesma regra do /mapas: a captura casa pelo id do mapa, nunca por lista à mão. */
const preview = (id: string) => `/img/map-previews/${id}.jpg`;
const [destaque, ...resto] = MAPAS;

const jsonld = [
  {
    '@type': 'ItemList',
    '@id': abs('/maps') + '#lista',
    name: `${BRAND_FULL} maps`,
    numberOfItems: MAPAS.length,
    itemListElement: MAPAS.map((m, i) => ({
      '@type': 'ListItem', position: i + 1, name: en(m.id).nome, description: en(m.id).resumo,
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'Maps', item: abs('/maps') },
    ],
  },
  { '@id': GAME_ID },
];
---
<Layout
  ogImage={abs('/api/og/mapas.png')}
  ogImageAlt={`Card with the ${MAPAS.length} arenas of ${BRAND_FULL}`}
  title={`Maps - the ${MAPAS.length} arenas | ${BRAND_FULL}`}
  description={`The ${MAPAS.length} arenas of ${BRAND_FULL}: ${MAPAS.map(m => en(m.id).nome).join(', ')} - layout, mode and how to play each one.`}
  jsonld={jsonld}
  h1="Maps"
  kicker={`${MAPAS.length} arenas · rounds and CTF`}
  heroImg={preview('ferro_velho')}
  heroPos="62%">
  {/* `{' '}` explícito entre expressões: dentro de um <Fragment slot>, o espaço
      literal entre `}` e `{` é engolido. */}
  <Fragment slot="sub">
    {MAPAS.length} playable arenas.{' '}{nRounds}{' '}{plural(nRounds, 'opens', 'open')} in rounds and
    {' '}{nCtf}{' '}{plural(nCtf, 'opens', 'open')} in Capture the Flag - but none of them locks the mode:
    you can play any map in any mode from the menu before the match.
  </Fragment>

  <article class="card wide" id={destaque.id}>
    <div class="fig">
      <img src={preview(destaque.id)} width="640" height="640" alt={`Aerial view of the ${en(destaque.id).nome} arena`} loading="eager" decoding="async">
    </div>
    <div class="card-body">
      <h2 class="map-nome">{en(destaque.id).nome}</h2>
      <p class="meta">
        <b>4v4</b><i>·</i>{destaque.ctf ? 'CTF' : 'Rounds'}<i>·</i>
        {destaque.ctf ? 'capture the flags' : '1:39 per round'}<i>·</i><code>{destaque.id}</code>
      </p>
      <p class="lead">{en(destaque.id).resumo}</p>
      <p>{en(destaque.id).detalhe}</p>
    </div>
  </article>

  <div class="grid cards">
    {resto.map(m => (
      <article class="card" id={m.id}>
        <div class="fig">
          <img src={preview(m.id)} width="640" height="640" alt={`Aerial view of the ${en(m.id).nome} arena`} loading="lazy" decoding="async">

        </div>
        <div class="card-body">
          <h3 class="map-nome">{en(m.id).nome}</h3>
          <p class="meta">
            <b>4v4</b><i>·</i>{m.ctf ? 'CTF' : 'Rounds'}<i>·</i>
            {m.ctf ? 'capture the flags' : '1:39 per round'}<i>·</i><code>{m.id}</code>
          </p>
          <p class="lead">{en(m.id).resumo}</p>
          <p>{en(m.id).detalhe}</p>
        </div>
      </article>
    ))}
  </div>

  <h2>Rounds or CTF</h2>
  <ul>
    <li><strong>Rounds:</strong> 4v4 by default (the menu goes from 1 to 8 per side), with a 2.2 s
      respawn. 1:39 rounds; the team with the most kills when the clock hits zero takes the round;
      In the default deathmatch setup, 3 rounds win the match and the 5th round is the cap; the menu offers best of 1, 3, 5 or 7.</li>
    <li><strong>Capture the Flag:</strong> flags spread across the arena, with their number and positions determined by each map. The geometry of
      {' '}{CTF_NOMES.join(', ')} was designed around them - that’s why those {nCtf} open
      in CTF. In CTF the round ends by capture, not by the clock.</li>
    <li>The map is drawn or picked on the selection screen, before the match starts.</li>
  </ul>

  <p style="margin-top:26px"><a class="btn-play" style="margin-left:0;display:inline-block" href="/?lang=en">▶ Enter the arena</a></p>
</Layout>
