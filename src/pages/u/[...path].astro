---
export const prerender=false;
Astro.response.headers.set("cache-control","no-store");
const id=(Astro.params.path || "").split("/")[0];
if(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id))return Astro.redirect(`/?secao=comunidade&social=profile&perfil=${encodeURIComponent(id)}`,302);
Astro.response.status=404;
---
<p>Perfil indisponível. <a href="/?secao=comunidade">Voltar ao jogo</a></p>
