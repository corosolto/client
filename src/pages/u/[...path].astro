---
export const prerender=false;
import {publicProfile} from '../../lib/public-profile';
import {SITE} from '../../lib/site';
import {PROFILE_CHARACTERS} from '../../../public/js/profile-character-catalog.js';
import CareerRank from '../../components/CareerRank.astro';
import {careerRankTitle} from '../../../public/js/career-rank.js';
import {profileSocialLinks} from '../../../public/js/ranking-player.js';
import Hub from '../index.astro';
Astro.response.headers.set('cache-control','no-store');
const segments=(Astro.params.path || '').split('/');
const key=segments[0];
// Abas de /u/<perfil>/<aba> (mesma lista de ABAS_PERFIL em public/js/rotas.js). Outro segmento é o nick antigo.
const ABAS:Record<string,string>={conquistas:'Conquistas',partidas:'Partidas',privacidade:'Privacidade'};
const aba=Object.hasOwn(ABAS,segments[1] || '')?segments[1]:null;
const {profile:p,status}=await publicProfile(key,Astro.request,Astro.clientAddress);
Astro.response.status=status;
const profileBase=p?`/u/${encodeURIComponent(p.handle || p.id)}`:'';
const canonical=p?SITE+(aba?(aba==='privacidade'?p.url:`${profileBase}/${aba}`):p.url):SITE+'/';
// Rodadas só chegam para o dono e amigos, e privacidade é do dono: fora do índice.
const noindex=!p || aba==='partidas' || aba==='privacidade';
const image=p?`${SITE}/api/profile-card/${encodeURIComponent(p.handle || p.id)}.png`:null;
const title=p?`${p.nick}${aba?` · ${ABAS[aba]}`:''} · CORO SOLTO`:'Perfil indisponível · CORO SOLTO';
const description=p?`${p.points} pontos · ${p.kills} abates · K/D ${p.kd}. Bora pra treta?`:'Este perfil está privado ou indisponível.';
const valid=/^(?:[a-z][a-z0-9_]{2,23}|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$/i.test(key);
const game=valid?`/?secao=comunidade&social=profile&perfil=${encodeURIComponent(p?.id || key)}`:'/?secao=comunidade';
const character=p && typeof p.last_character==='string' && Object.hasOwn(PROFILE_CHARACTERS,p.last_character)?PROFILE_CHARACTERS[p.last_character]:null;
const stats=p?[['Pontos',p.points],['Abates',p.kills],['Mortes',p.deaths],['K/D',p.kd],['Rodadas ganhas',p.round_wins ?? p.wins]]:[];
const https=(value:string)=>{try{const u=new URL(value);return u.protocol==='https:' && !u.username && !u.password?u.href:null;}catch{return null;}};
// Clã vem na mesma resposta do perfil (backend#72), já filtrada pela privacidade social.
const clan=p?.clan && /^[A-Z0-9]{2,5}$/.test(p.clan.tag) && /^[0-9a-f-]{36}$/i.test(p.clan.id)?p.clan:null;
const CONQUISTAS:Record<string,string>={first_kill:'Primeiro abate',ten_kills:'Dez abates na conta',first_win:'Primeira vitória',one_hour:'Uma hora de arena ativa'};
const avatar=p?.avatar_url===`/api/social-avatar?id=${p?.id}`?p.avatar_url:https(p?.avatar_url);
/* /u/<perfil> É O HUB (pedido do dono, 14/10): a mesma página do jogo, com o head deste perfil
   e o perfil legível no slot `perfil` (crawler e prévia de link). O hub não lê disco no render
   (revisão de CSS e manifesto vêm do build), então o SSR não volta a dar 200 com 0 bytes. */
const hubRota={caminho:p?canonical.slice(SITE.length):'/',canonical:p?canonical.slice(SITE.length):'/',titulo:p?p.nick:'Perfil indisponível',tituloPagina:title,descricao:description,indexavel:!noindex,ogTipo:'profile',
  estado:{secao:'comunidade',social:'profile',perfil:p?.id || key,...(aba?{aba}:{})},hasProfileHeading:true,
  imagem:image?{url:image,alt:`Perfil e placar de ${p.nick}`} : null,
  jsonLd:p && !noindex?{'@context':'https://schema.org','@type':'ProfilePage',url:canonical,name:title,mainEntity:{'@type':'Person',name:p.nick,...(p.handle?{alternateName:`@${p.handle}`} : {}),url:SITE+p.url,...(image?{image}:{})},isPartOf:{'@id':`${SITE}/#website`}}:undefined};
---
<Hub rota={hubRota}><div slot="perfil" id="perfil-ssr" class="perfil-ssr">
{p?<article class="profile-sheet">
  <div class="profile-details">
    <div class="identity">{avatar && <img class="avatar" src={avatar} alt={`Avatar de ${p.nick}`} width="72" height="72" referrerpolicy="no-referrer"/>}<h1>{clan && <span class="clan-tag">[{clan.tag}] </span>}{p.nick}</h1></div>
    {p.account_verified===true && <span class="account-verified" role="img" aria-label="Conta verificada: e-mail confirmado e rede social vinculada." title="Conta verificada: e-mail confirmado e rede social vinculada.">✓ VERIFICADO</span>}
    {p.handle && <p class="handle">@{p.handle}</p>}
    {clan && <p class="clan"><a href={`/clans/${clan.id}`}>Clã {clan.name} ↗</a></p>}
    {p.bio && <p class="bio">{p.bio}</p>}
    <p class="level">Nível {p.level} · {p.next_level_points} pontos para o próximo</p>
    <div class="profile-career"><CareerRank points={p.points}/>{careerRankTitle(p.points) && <p>{careerRankTitle(p.points)}</p>}</div>
    <div class="profile-ranking" aria-label="Posição no ranking geral"><span>Ranking geral</span><strong>{p.position?`#${p.position}`:'-'}</strong></div>
    {Number.isSafeInteger(p.views) && p.views>=0 && <p class="views">{p.views.toLocaleString('pt-BR')} {p.views===1?'visualização':'visualizações'}</p>}
    <dl class="profile-stats">{stats.map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>
    {p.source==='historical_plus_server_verified' && <p class="source">Histórico preservado + partidas confirmadas pelo servidor.</p>}
    {/* Redes no template, não no frontmatter: a régua do backend executa o frontmatter sem este módulo. */}
    {profileSocialLinks(p).length>0 && <nav class="socials" aria-label="Redes públicas do jogador">{profileSocialLinks(p).map(s=><a href={s.url} target="_blank" rel="noopener noreferrer nofollow" title={s.label} aria-label={`${s.label} (abre em nova aba)`}><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={s.path}/></svg><span>{s.label}</span></a>)}</nav>}
    <nav class="profile-tabs" aria-label="Abas do perfil">
      <a href={p.url} aria-current={!aba?'page':undefined}>Perfil</a>
      {Object.entries(ABAS).map(([slug,nome])=><a href={`${profileBase}/${slug}`} aria-current={aba===slug?'page':undefined}>{nome}</a>)}
    </nav>
    {aba==='conquistas' && <section class="profile-aba" aria-labelledby="aba-titulo"><h2 id="aba-titulo">Conquistas</h2>{(p.achievements || []).length?<ul>{p.achievements.map((a)=><li>{CONQUISTAS[a.key] || a.key}{a.at && <span> · {new Date(a.at).toLocaleDateString('pt-BR')}</span>}</li>)}</ul>:<p>A primeira conquista vem da primeira treta confirmada.</p>}</section>}
    {/* Solo é dado do aparelho do jogador: sem o rótulo esta lista pública passa por rodada confirmada. */}
    {aba==='partidas' && <section class="profile-aba" aria-labelledby="aba-titulo"><h2 id="aba-titulo">Partidas</h2>{(p.history || []).length?<ul>{p.history.map((h)=><li>{h.map} · {h.mode} · {h.kills} abates / {h.deaths} mortes{h.source==='client_solo_unverified'?' · Solo, não vale ranking':''}</li>)}</ul>:<p>As rodadas deste jogador aparecem para ele e para os amigos dele, dentro do jogo.</p>}</section>}
    {aba==='privacidade' && <section class="profile-aba" aria-labelledby="aba-titulo"><h2 id="aba-titulo">Privacidade</h2><p>Esta página mostra só o que {p.nick} deixou público. Quem vê o perfil, a presença e a atividade é escolha de cada jogador.</p><p>Para mudar o que aparece no seu perfil, entre na sua conta e abra as configurações.</p><a class="play" href="/comunidade/configuracoes">ABRIR MINHAS CONFIGURAÇÕES ▸</a></section>}
    {/* Sem JS e para crawler: o mesmo perfil aberto no hub. Com JS o hub já está aqui e a comunidade troca este bloco. */}
    <a class="play profile-action" href={game}>ABRIR NO JOGO ▸</a>
  </div>
  {character?<figure class="profile-character"><img src={character.portrait} alt={character.nome} width="480" height="580"/><figcaption><span>Último personagem</span><strong>{character.nome}</strong></figcaption></figure>:<div class="character-empty"><p>Personagem não compartilhado.</p><span>O jogador escolhe se mostra o último personagem, e só rodada confirmada pelo servidor conta.</span></div>}
</article>:<section class="unavailable"><h1>Perfil indisponível</h1><p>{description}</p><a class="play" href={game}>VOLTAR AO JOGO ▸</a></section>}
</div></Hub>
{!p && valid && <script is:inline define:vars={{game}}>location.replace(game);</script>}
