---
export const prerender=false;
import {publicProfile,PROFILE_SITE} from '../../lib/public-profile';
import {PROFILE_CHARACTERS} from '../../../public/js/profile-character-catalog.js';
import CareerRank from '../../components/CareerRank.astro';
import {careerRankTitle} from '../../../public/js/career-rank.js';
Astro.response.headers.set('cache-control','no-store');
const key=(Astro.params.path || '').split('/')[0];
const {profile:p,status}=await publicProfile(key,Astro.request,Astro.clientAddress);
Astro.response.status=status;
const canonical=p?PROFILE_SITE+p.url:PROFILE_SITE+'/';
const image=p?`${PROFILE_SITE}/api/profile-card/${encodeURIComponent(p.handle || p.id)}.png`:null;
const title=p?`${p.nick} · CORO SOLTO`:'Perfil indisponível · CORO SOLTO';
const description=p?`${p.points} pontos · ${p.kills} abates · K/D ${p.kd}. Bora pra treta?`:'Este perfil está privado ou indisponível.';
const valid=/^(?:[a-z][a-z0-9_]{2,23}|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$/i.test(key);
const game=valid?`/?secao=comunidade&social=profile&perfil=${encodeURIComponent(p?.id || key)}`:'/?secao=comunidade';
const character=p && typeof p.last_character==='string' && Object.hasOwn(PROFILE_CHARACTERS,p.last_character)?PROFILE_CHARACTERS[p.last_character]:null;
const stats=p?[['Pontos',p.points],['Abates',p.kills],['Mortes',p.deaths],['K/D',p.kd],['Rodadas ganhas',p.round_wins ?? p.wins]]:[];
const https=(value:string)=>{try{const u=new URL(value);return u.protocol==='https:' && !u.username && !u.password?u.href:null;}catch{return null;}};
const socials=p && Array.isArray(p.socials)?p.socials.map((s:any)=>({name:String(s.net || 'Perfil'),url:https(s.url)})).filter((s:any)=>s.url):[];
const avatar=p?.avatar_url===`/api/social-avatar?id=${p?.id}`?p.avatar_url:https(p?.avatar_url);
---
<!doctype html><html lang="pt-BR" data-home-ui="hub" class="public-profile"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="icon" href="/favicon.ico"/><link rel="stylesheet" href="/style.css"/>
<meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:type" content="profile"/>
{image && <><meta property="og:image" content={image}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content={`Perfil e placar de ${p.nick}`}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:image" content={image}/></>}
{!p && <meta name="robots" content="noindex"/>}
</head><body>
<a class="skip-link" href="#perfil">Ir para o perfil</a>
<header><a href="/" aria-label="CORO SOLTO - voltar ao jogo"><img src="/logo.png" alt="CORO SOLTO: Treta Suprema" width="140" height="84"/></a><a class="play" href="/">JOGAR AGORA ↗</a></header>
<main id="perfil" tabindex="-1">
{p?<article class="profile-sheet">
  <div class="profile-details">
    <div class="identity">{avatar && <img class="avatar" src={avatar} alt={`Avatar de ${p.nick}`} width="72" height="72" referrerpolicy="no-referrer"/>}<h1>{p.nick}</h1></div>
    {p.account_verified===true && <span class="account-verified" role="img" aria-label="Conta verificada: e-mail confirmado e rede social vinculada." title="Conta verificada: e-mail confirmado e rede social vinculada.">✓ VERIFICADO</span>}
    {p.handle && <p class="handle">@{p.handle}</p>}
    {p.bio && <p class="bio">{p.bio}</p>}
    <p class="level">Nível {p.level} · {p.next_level_points} pontos para o próximo</p>
    <div class="profile-career"><CareerRank points={p.points}/>{careerRankTitle(p.points) && <p>{careerRankTitle(p.points)}</p>}</div>
    <div class="profile-ranking" aria-label="Posição no ranking geral"><span>Ranking geral</span><strong>{p.position?`#${p.position}`:'-'}</strong></div>
    <dl class="profile-stats">{stats.map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>
    {p.source==='historical_plus_server_verified' && <p class="source">Histórico preservado + partidas confirmadas pelo servidor.</p>}
    {socials.length>0 && <nav class="socials" aria-label="Redes do jogador">{socials.map((s:any)=><a href={s.url} target="_blank" rel="noopener noreferrer nofollow">{s.name} ↗</a>)}</nav>}
    <a class="play profile-action" href={game}>VER PERFIL NO JOGO ▸</a>
  </div>
  {character?<figure class="profile-character"><img src={character.portrait} alt={character.nome} width="480" height="580"/><figcaption><span>Último personagem</span><strong>{character.nome}</strong></figcaption></figure>:<div class="character-empty"><p>Nenhum personagem disponível para mostrar.</p><span>A próxima treta começa no jogo.</span></div>}
</article>:<section class="unavailable"><h1>Perfil indisponível</h1><p>{description}</p><a class="play" href={game}>VOLTAR AO JOGO ▸</a></section>}
</main>
<footer><span>CORO SOLTO: TRETA SUPREMA</span><nav aria-label="Informações do jogo"><a href="/privacidade">Privacidade</a><a href="/termos">Termos de uso</a></nav></footer>
{!p && valid && <script is:inline define:vars={{game}}>location.replace(game);</script>}
</body></html>
<style>
:global(html.public-profile),:global(.public-profile body){height:auto;min-height:100%;overflow:auto;background:#0d1110;color:#eff0e9}:global(.public-profile *){user-select:text}body{font-family:'Barlow Condensed','Arial Narrow',Arial,sans-serif;margin:0;background:radial-gradient(ellipse at 85% 40%,#29331d 0,transparent 55%)}a{color:#b4d92e;text-underline-offset:4px}a:focus-visible{outline:3px solid #b4d92e;outline-offset:5px}.skip-link{position:absolute;top:-80px;left:20px;z-index:10;background:#0d1110;padding:12px}.skip-link:focus{top:12px}header,footer{display:flex;align-items:center;justify-content:space-between;gap:20px;max-width:1200px;margin:auto;padding:20px 28px}header{border-bottom:1px solid #454b40}header img{object-fit:contain}.play{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:10px 24px;border:1px solid #d7f085;background:#b4d92e;color:#15190e;text-decoration:none;font-weight:700;font-size:22px;box-shadow:0 4px 0 #607623,inset 0 1px 0 #e6fcb0;transition:transform .15s,box-shadow .15s}.play:hover{transform:translateY(-1px)}.play:active{transform:translateY(3px);box-shadow:0 1px 0 #607623}main{max-width:1200px;margin:36px auto;padding:0 28px}.profile-sheet{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);border:1px solid #454b40;border-top:5px solid #b4d92e;background:#101613}.profile-details{padding:36px}.identity{display:flex;align-items:center;gap:16px;min-width:0}h1{font:clamp(38px,5vw,66px)/1 'Bebas Neue','Arial Narrow',sans-serif;margin:0;overflow-wrap:anywhere}.avatar{flex:0 0 72px;object-fit:cover;border:1px solid #454b40;border-radius:4px}.handle{font:14px system-ui,sans-serif;color:#bfc7b8;margin:12px 0}.bio{font:16px/1.6 system-ui,sans-serif;overflow-wrap:anywhere}.level,.source{font:13px/1.6 system-ui,sans-serif;color:#bfc7b8}.account-verified{display:inline-flex;margin-top:12px;padding:3px 7px;border:1px solid #77c4e9;border-radius:3px;background:#142d3d;color:#a4e0ff;font:700 10px/1.5 system-ui,sans-serif;letter-spacing:.3px}.profile-ranking{display:flex;align-items:center;gap:20px;margin:28px 0}.profile-ranking span{font:18px 'Barlow Condensed',sans-serif;text-transform:uppercase;letter-spacing:1px;color:#c3ccbb}.profile-ranking strong{font:88px/1 'Bebas Neue',sans-serif;color:#b4d92e}.profile-stats{display:flex;flex-wrap:wrap;gap:18px 28px;padding:20px 0;margin:24px 0;border-top:1px solid #454b40;border-bottom:1px solid #454b40}.profile-stats>div{display:flex;flex-direction:column-reverse;gap:4px}.profile-stats dt{font-size:13px;text-transform:uppercase;color:#c3ccbb}.profile-stats dd{font:30px 'Bebas Neue',sans-serif;margin:0}.socials{display:flex;gap:16px;flex-wrap:wrap;font:14px system-ui,sans-serif;margin:20px 0}.profile-action{margin-top:12px}.profile-character{margin:0;display:flex;flex-direction:column;justify-content:center;align-items:center;min-width:0;padding:24px;background:radial-gradient(ellipse,#3b4825,transparent 70%);border-left:1px solid #454b40}.profile-character img{display:block;width:100%;max-width:420px;height:460px;object-fit:contain}.profile-character figcaption{display:grid;text-align:center;gap:8px;padding:16px}.profile-character figcaption span{font:12px system-ui,sans-serif;color:#c3ccbb}.profile-character strong{font:32px 'Bebas Neue',sans-serif}.character-empty{display:grid;align-content:center;text-align:center;gap:8px;padding:32px;border-left:1px solid #454b40;color:#c3ccbb}.character-empty p{font-size:24px;margin:0}.character-empty span{font:14px system-ui,sans-serif}.unavailable{padding:40px;border-left:3px solid #b4d92e}.unavailable p{margin:24px 0}footer{border-top:1px solid #454b40;font:12px system-ui,sans-serif;color:#bfc7b8}footer nav{display:flex;gap:20px}@media(max-width:760px){header,footer{padding:16px 20px}main{margin:24px auto;padding:0 16px}.profile-sheet{grid-template-columns:1fr}.profile-details{padding:24px}.profile-character,.character-empty{border-left:0;border-top:1px solid #454b40}.profile-character img{height:340px}header img{width:112px;height:68px}.play{font-size:18px;padding:10px 16px}footer{flex-wrap:wrap}.profile-stats{gap:18px 24px}.profile-ranking strong{font-size:72px}.avatar{width:56px;height:56px;flex-basis:56px}}
</style>
