---
// /weapons - GÊMEA EM INGLÊS do /armas (pedido do dono, 06/08: usuário em EN
// cai na versão EN). Mesmo dataset (src/data/jogo.ts); classes, notas e textos
// das granadas traduzidos AQUI por overlay - o PT continua a fonte. Os NOMES
// das armas ('AWP "DELIBERADOR"' etc.) são marca própria e ficam em PT, como
// characters.astro fez com os personagens. Redirecionamento por idioma: cada
// página manda pro par quando o idioma resolvido não bate (mesmas regras do
// public/js/i18n.js).
import Layout from '../layouts/Layout.astro';
import { ARMAS, ARREMESSO } from '../data/jogo';
import { BRAND_FULL, GAME_ID, abs } from '../lib/site';

// As classes viram os títulos das seções (h2) e entram no JSON-LD - por isso
// precisam de overlay, ao contrário dos nomes de arma, que ficam como estão.
const CLASSE_EN: Record<string, string> = {
  'Sniper': 'Sniper',
  'Sniper semi-auto': 'Semi-auto sniper',
  'Fuzil': 'Assault rifle',
  'Fuzil de batalha': 'Battle rifle',
  'Carabina': 'Carbine',
  'Bullpup': 'Bullpup',
  'Carabina de alavanca': 'Lever-action carbine',
  'Metralhadora': 'LMG',
  'SMG': 'SMG',
  'Escopeta': 'Shotgun',
  'Pistola': 'Pistol',
  'Corpo a corpo': 'Melee',
};
const NOTA_EN: Record<string, string> = {
  awp: 'One-shot kill anywhere on the body. It is the weapon that defines the arena - and the one that punishes shooting on the move the hardest.',
  mosin: 'Slow bolt, brutal damage. Less forgiving than the AWP, and it rewards the crouched shot more.',
  rem700: 'The Mosin’s civilian sister: same pace, a hair more damage.',
  svd: 'Semi-auto: two shots drop a target, and you never lose your sight picture between them.',
  g3sg1: 'A 20-round mag on a semi-auto sniper. The pick for holding a long angle alone.',
  sks: 'The fastest of the semi-autos. Rewards whoever lands the panic follow-up.',
  ak: 'Kills in 3 body shots. The gold standard of rifles: high damage, honest recoil.',
  akm: 'The AK’s heavy cousin: 4 shots to the body, a touch slower.',
  m4: 'Faster and steadier than the AK, in exchange for damage per shot.',
  g3: 'Short mag, painful hits. A rifle for those who count their shots.',
  md97: 'The Brazilian rifle of the arsenal. The highest damage per shot among the automatics.',
  m400: 'Battle-rifle damage with M4 stability.',
  scar: 'Balanced to a fault - the least surprising gun, for better and for worse.',
  m92: 'A sawed-off AK. Short, fat on screen, and great in corridors.',
  tavor: 'Bullpup: rifle barrel in an SMG body. Great in tight spaces.',
  famas: 'Very high fire rate, short mag. Misses little in the hands of someone who controls the burst.',
  carbine: 'Slow lever, high damage. The most backwoods and most satisfying gun in the game.',
  lmg: '100 rounds without reloading. Locks down a whole corridor - if you can carry the weight.',
  mp5: 'The reference SMG: predictable, accurate, no drama.',
  uzi: 'Spits the mag in 1.7 s. Up close it works; at range it is fireworks.',
  p90: '50 rounds and the highest fire rate in the arsenal. Damage per shot is the price.',
  shotgun: '9 pellets of 14 per shot: 126 damage if everything connects. Thing is, it never all connects.',
  deagle: 'A pistol that kills in 2. A headshot settles the round.',
  revolver38: 'Six shots, plenty of noise, and no hurry at all.',
  pistol: 'The standard sidearm. Kills in 3 and gets you out of a pinch when the primary runs dry.',
  knife: '2.4 m reach. You move faster with it in hand - and it humiliates more, too.',
};
const THROW_EN: Record<string, { nome: string; efeito: string; nota: string }> = {
  smoke: {
    nome: 'SMOKE',
    efeito: 'Cloud that blocks line of sight for 13 s',
    nota: 'Five per round - it is the grenade you have to spare. Cuts sniper angles, covers crossings '
      + 'and smothers the flag in CTF. The cloud’s color is the map’s sky multiplied by 0.75, so it never '
      + 'washes the screen to white.',
  },
  frag: {
    nome: 'FRAG GRENADE',
    efeito: 'Up to 95 damage at the epicenter, falling to zero at the edge',
    nota: 'ONE per round. Damage falls linearly with distance: 95 on top of it, ~47 at half radius, '
      + 'zero at the edge. It does not hit your own team, and the short fuse (1.5 s) means it pops '
      + 'almost where it lands - lobbing it over cover is the play, not throwing it far.',
  },
};

const classeEn = (c: string) => CLASSE_EN[c] || c;
const notaEn = (id: string, fallback: string) => NOTA_EN[id] || fallback;
const throwEn = (id: string) => THROW_EN[id];

const classes = [...new Set(ARMAS.map(a => a.classe))];
const porClasse = classes.map(c => ({ classe: classeEn(c), armas: ARMAS.filter(a => a.classe === c) }));

// Mesma regra do /armas: só as 3 primeiras miniaturas carregam `eager` (as que
// estão acima da dobra em 1200×800); as outras 23 não competem com o LCP.
const ordem = new Map(porClasse.flatMap(g => g.armas).map((a, i) => [a.id, i]));

// Mesma estrutura do JSON-LD do /armas, com textos traduzidos e URLs do par EN.
const jsonld = [
  {
    '@type': 'ItemList',
    '@id': abs('/weapons') + '#lista',
    name: `${BRAND_FULL} arsenal`,
    description: `The ${ARMAS.length} playable weapons: damage, magazine, reserve ammo and fire rate.`,
    numberOfItems: ARMAS.length,
    itemListOrder: 'https://schema.org/ItemListUnordered',
    itemListElement: ARMAS.map((a, i) => ({
      '@type': 'ListItem', position: i + 1, name: a.nome,
      description: `${classeEn(a.classe)} · ${a.dano} damage · ${a.pente}-round mag. ${notaEn(a.id, a.nota)}`,
    })),
  },
  // Lista PRÓPRIA para as duas de arremesso, pelo mesmo motivo do /armas:
  // engordar o numberOfItems para 28 passaria a chamar fumaça de arma de fogo.
  {
    '@type': 'ItemList',
    '@id': abs('/weapons') + '#arremesso',
    name: `${BRAND_FULL} grenades`,
    description: `The ${ARREMESSO.length} throwables: amount per round, fuse and radius.`,
    numberOfItems: ARREMESSO.length,
    itemListOrder: 'https://schema.org/ItemListUnordered',
    itemListElement: ARREMESSO.map((a, i) => ({
      '@type': 'ListItem', position: i + 1, name: throwEn(a.id)?.nome || a.nome,
      description: `${a.quantidade} per round · ${a.fusivel} s fuse · ${a.raio} m radius. ${throwEn(a.id)?.efeito || a.efeito}.`,
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'Weapons', item: abs('/weapons') },
    ],
  },
  { '@id': GAME_ID },
];
---
<Layout
  ogImage={abs('/api/og/armas.png')}
  ogImageAlt={`Card with the ${BRAND_FULL} arsenal`}
  title={`Weapons - all ${ARMAS.length} in the arsenal | ${BRAND_FULL}`}
  description={`Every one of the ${ARMAS.length} weapons in ${BRAND_FULL}: AWP, AK-47, M4A1, MD97, Mosin, shotgun, SMGs and knife - with image, damage, mag, reserve and fire rate for each, plus the ${ARREMESSO.length} grenades.`}
  jsonld={jsonld}
  h1="Arsenal"
  kicker={`${ARMAS.length} weapons · ${classes.length} classes · ${ARREMESSO.length} throwables`}
  heroImg="/img/map-previews/loja_h.jpg"
  heroPos="66%">
  <Fragment slot="sub">
    {ARMAS.length} playable weapons across {classes.length} classes. The numbers below are the same
    ones the game uses in a match - damage per projectile, magazine size, reserve ammo and the delay
    between shots in seconds. Swap weapons with <code>1</code> (primary), <code>2</code> (pistol) and
    <code>3</code> (knife) - and the two throwable grenades on <code>4</code> (smoke) and
    <code>5</code> (frag).
  </Fragment>

  <div class="panel">
    <strong style="color:var(--amber)">How to read the table.</strong>
    <p style="margin-top:6px">
      <b>DAMAGE</b> is per projectile that hits the body - headshots multiply, and the M3 fires 9
      pellets of {ARMAS.find(a => a.id === 'shotgun')?.dano} per shot. <b>DELAY</b> is the time between
      shots: lower is faster. The AWP kills with one shot anywhere on the body; it is the only weapon
      in the game with that property, and it is what sets the pace of the arena.
    </p>
    <p style="margin-top:6px">
      <b>THE IMAGES ARE THE GAME'S MODELS</b>, rendered from the same 3D file that loads in a match -
      not illustrations. All of them were shot with the same camera and the same box, so one gun's
      size against another is the real size: the knife is that tiny thing next to the Mosin because
      it is 4.9× smaller.
    </p>
  </div>

  {porClasse.map(({ classe, armas }) => (
    <>
      <h2>{classe} · {armas.length}</h2>
      <div class="tw">
        <table>
          <thead>
            <tr>
              <th scope="col">Weapon</th>
              <th scope="col" class="num">Damage</th>
              <th scope="col" class="num">Mag</th>
              <th scope="col" class="num">Reserve</th>
              <th scope="col" class="num">Delay (s)</th>
            </tr>
          </thead>
          <tbody>
            {armas.map(a => (
              <>
                <tr class="top">
                  <td>
                    <img class="wshot" src={`/img/weapons/${a.id}.webp`}
                      width="360" height="138" alt={`In-game 3D model of the ${a.nome}`}
                      loading={(ordem.get(a.id) ?? 99) < 3 ? 'eager' : 'lazy'}
                      decoding="async">
                    <strong>{a.nome}</strong></td>
                  <td class="num">{a.dano}{a.id === 'shotgun' ? ' ×9' : ''}</td>
                  <td class="num">{a.pente || ' - '}</td>
                  <td class="num">{a.reserva || ' - '}</td>
                  <td class="num">{a.cadencia}</td>
                </tr>
                <tr>
                  <td colspan="5" style="border-bottom:1px solid #1e1a0e;color:var(--bone-dim);font-size:12px;padding-top:0">
                    {notaEn(a.id, a.nota)}
                  </td>
                </tr>
              </>
            ))}
          </tbody>
        </table>
      </div>
    </>
  ))}

  <h2>Throwables · {ARREMESSO.length}</h2>
  <p style="color:var(--bone-dim);font-size:13px;margin:-4px 0 12px">
    They are not firearms and do not count toward the {ARMAS.length} above, but they are playable and
    sit on the HUD of every match (the <code>💨</code> and the <code>🧨</code> in the corner). You get
    both at the start of each round and they <b>do not carry over to the next one</b>.
  </p>
  <div class="tw">
    <table>
      <thead>
        <tr>
          <th scope="col">Grenade</th>
          <th scope="col">Key</th>
          <th scope="col" class="num">Per round</th>
          <th scope="col" class="num">Fuse (s)</th>
          <th scope="col" class="num">Radius (m)</th>
        </tr>
      </thead>
      <tbody>
        {ARREMESSO.map(a => (
          <>
            <tr class="top">
              <td><strong>{throwEn(a.id)?.nome || a.nome}</strong></td>
              <td><code>{a.tecla}</code></td>
              <td class="num">{a.quantidade}</td>
              <td class="num">{a.fusivel}</td>
              <td class="num">{a.raio}</td>
            </tr>
            <tr>
              <td colspan="5" style="border-bottom:1px solid #1e1a0e;color:var(--bone-dim);font-size:12px;padding-top:0">
                <b style="color:var(--amber-dim)">{throwEn(a.id)?.efeito || a.efeito}.</b> {throwEn(a.id)?.nota || a.nota}
              </td>
            </tr>
          </>
        ))}
      </tbody>
    </table>
  </div>

  <h2>Which one to pick</h2>
  <ul>
    <li><strong>Starting out:</strong> AK-47. Kills in 3 body shots and forgives bad positioning.</li>
    <li><strong>Long angles:</strong> AWP at Praça dos Três Poderes, G3SG1 if you would rather not lose your sight picture between shots.</li>
    <li><strong>Close quarters (Piscina da Treta, Loja H):</strong> MP5, P90 or the M3.</li>
    <li><strong>Pure humiliation:</strong> the knife. You move faster with it in hand.</li>
  </ul>

  <div class="cta-row">
    <a class="btn-cta" href="/?lang=en">▶ Try it in the game</a>
    <a class="btn-cta btn-2" href="/how-to-play">How to play</a>
  </div>
</Layout>

<script>
  // espelho do /armas: usuário em pt vai pra gêmea PT (mesmas regras do i18n.js do jogo)
  try {
    const q = new URLSearchParams(location.search).get('lang');
    const ls = localStorage.getItem('cs_lang');
    const lang = (q === 'pt' || q === 'en') ? q : (ls === 'pt' || ls === 'en') ? ls
      : (/^pt/i.test(navigator.language || '') ? 'pt' : 'en');
    if (lang === 'pt') location.replace('/armas');
  } catch { /* storage bloqueado: fica onde está */ }
</script>

<style>
  /* Mesma decisão de layout do /armas: a miniatura vive empilhada na PRIMEIRA
     coluna, acima do nome, para não empurrar o scroll horizontal do celular -
     e para as 26 miniaturas alinhadas denunciarem qualquer arma fora do ângulo
     do catálogo na hora. */
  .wshot{display:block;width:180px;height:69px;max-width:100%;margin:0 0 2px -6px}
  /* 180×69 exibido a partir de um arquivo 360×138: 2× de densidade, que é o que mantém
     o cano - 2 px de espessura - sem serrilha em tela retina. `width`/`height` no HTML
     reservam a caixa antes do byte chegar. */
  td:has(> .wshot){padding-top:10px;min-width:196px}
</style>
