---
// /grupos/<id> - um recorte por grupo editorial do elenco.
// A fonte é src/data/jogo.ts. Grupos não são times: toda partida usa Time E e Time B.
import Layout from '../../layouts/Layout.astro';
import { GRUPOS, PERSONAGENS, capaDoGrupo } from '../../data/jogo';
import { BRAND_FULL, GAME_ID, abs } from '../../lib/site';

export function getStaticPaths() {
  return GRUPOS.map((g) => ({ params: { id: g.id }, props: { grupo: g } }));
}

const { grupo } = Astro.props;
const elenco = PERSONAGENS.filter((p) => p.grupo === grupo.id);
const outros = GRUPOS.filter((g) => g.id !== grupo.id);
const url = abs(`/grupos/${grupo.id}`);

const placa = capaDoGrupo(grupo.id);

const jsonld = [
  {
    '@type': 'ItemList',
    '@id': url + '#lista',
    name: `Personagens do grupo ${grupo.nome}`,
    description: grupo.nota,
    numberOfItems: elenco.length,
    itemListElement: elenco.map((p, i) => ({
      '@type': 'ListItem', position: i + 1, name: p.nome,
      item: {
        '@type': 'Person', name: p.nome, description: p.blurb,
        additionalType: 'https://schema.org/FictionalCharacter',
      },
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'Personagens', item: abs('/personagens') },
      { '@type': 'ListItem', position: 3, name: grupo.nome, item: url },
    ],
  },
  { '@id': GAME_ID },
];
---
<Layout
  title={`${grupo.nome} - ${elenco.length} personagens do grupo | ${BRAND_FULL}`}
  description={`${grupo.nota} Conheça os ${elenco.length} personagens do grupo ${grupo.nome} no ${BRAND_FULL}, com o lema “${grupo.lema}”.`}
  ogImage={placa ? abs(placa) : undefined}
  ogImageAlt={`Personagens do grupo ${grupo.nome} no ${BRAND_FULL}`}
  jsonld={jsonld}
  h1={grupo.nome}
  kicker={`grupo do elenco · ${elenco.length} personagens`}
  heroImg={placa}
  heroPos="50% 24%">
  <Fragment slot="sub">
    “{grupo.lema}” - {grupo.nota}
  </Fragment>

  <p class="meta"><b>{elenco.length} personagens</b><i>·</i>grupo {grupo.nome}<i>·</i>
    <a href="/personagens">ver os {GRUPOS.length} grupos</a></p>

  {placa && (
    <div class="fig" style="margin:18px 0">
      <img src={placa} width="640" height="1601" loading="lazy" decoding="async"
           alt={`Os ${elenco.length} personagens do grupo ${grupo.nome} no ${BRAND_FULL}`}>
      <span class="fig-tag" style={`background:${grupo.cor};color:#141008`}>{grupo.nome}</span>
    </div>
  )}

  <h2>O elenco</h2>
  <div class="grid roster" style={`--fc:${grupo.cor}`}>
    {elenco.map((p) => (
      <article class="pcard">
        <img class="pfoto" src={`/img/chars/avatars/${p.id}.webp`} width="256" height="256"
             loading="lazy" decoding="async" alt={p.nome}>
        <strong>{p.nome}</strong>
        <p>{p.blurb}</p>
      </article>
    ))}
  </div>

  <h2>Outros grupos</h2>
  <p>
    {outros.map((g, i) => (
      <Fragment>
        <a href={`/grupos/${g.id}`} style={`color:${g.cor}`}>{g.nome}</a>{i < outros.length - 1 ? ' · ' : ''}
      </Fragment>
    ))}
  </p>
  <p style="margin-top:10px">
    Todos os {GRUPOS.length} grupos numa página só: <a href="/personagens">personagens</a>.
    Nenhum personagem representa pessoa real - são arquétipos, e a zoeira é distribuída
    igualmente. <a href="/">▶ JOGAR</a>
  </p>
</Layout>

<style>
  .grid.roster{grid-template-columns:repeat(auto-fill,minmax(238px,1fr))}
  @media(max-width:860px){.grid.roster{grid-template-columns:1fr}}
  .pfoto{width:100%;height:auto;max-width:180px;aspect-ratio:1;object-fit:cover;object-position:center;
    border-radius:6px;border:1px solid var(--line-2,#333);margin:0 auto 8px;display:block;background:#1c1a20}
  .pcard{text-align:center;background:var(--panel);border:1px solid var(--line);border-left:3px solid var(--fc);
    padding:12px 14px}
  .pcard:hover{background:var(--panel-2);border-color:var(--line-hi)}
  .pcard strong{color:var(--ink);letter-spacing:1px;font-size:13px;display:block}
  .pcard p{margin-top:5px;font-size:12.5px;line-height:1.55}
</style>
