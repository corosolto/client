---
import Layout from '../layouts/Layout.astro';
import { LIVE_MAP } from '../data/live-map.mjs';
import { BRAND_FULL, GAME_ID, abs } from '../lib/site';

export const prerender = false;

Astro.response.headers.set(
  'cache-control',
  'public, max-age=0, s-maxage=300, stale-while-revalidate=900',
);
---
<Layout
  title={`Mapa da treta - de onde a comunidade joga | ${BRAND_FULL}`}
  description={LIVE_MAP.description}
  jsonld={[{ '@id': GAME_ID }, { '@type': 'FAQPage', '@id': abs('/mapa') + '#faq', mainEntity: LIVE_MAP.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) }, {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'Mapa ao vivo', item: abs('/mapa') },
    ],
  }]}
  h1="Mapa da treta"
  kicker="Comunidade · histórico por cidade"
  heroImg="/img/map-previews/quebrada.jpg"
  heroPos="40%"
>
  <Fragment slot="sub">
    De onde a comunidade joga, cidade por cidade. A localização é um centroide aproximado:
    nenhum IP, posição individual ou nome de jogador aparece aqui.
  </Fragment>

  <!-- Leaflet 1.9.4 (BSD-2-Clause) vendorizado em public/vendor/leaflet/. -->
  <link rel="stylesheet" href="/vendor/leaflet/leaflet.css" slot="head">
  <style slot="head">
    .map-tip{background:rgba(8,12,8,.88)!important;border:1px solid #4a5a2a!important;color:#d8e0b0!important;
      font:10px Consolas,monospace;padding:1px 6px;box-shadow:none!important}
    .map-tip:before{display:none}
    .map-pop .leaflet-popup-content-wrapper{background:#10130c;color:#d8e0b0;border:1px solid #4a5a2a;font-family:Consolas,monospace;font-size:12px}
    .map-pop .leaflet-popup-tip{background:#10130c;border:1px solid #4a5a2a}
  </style>

  <p>Em amarelo, o histórico agregado de partidas por cidade. A presença pessoal fica somente na lista de amigos autorizados.</p>
  <div id="map" aria-label="Mapa de partidas por cidade"></div>
  <p id="map-status" role="status">Carregando cidades...</p>
  <section class="city-panel" aria-labelledby="city-title">
    <h2 id="city-title">Partidas por cidade</h2>
    <ul id="city-list"></ul>
  </section>

  <script src="/vendor/leaflet/leaflet.js" is:inline></script>
  <script is:inline>
    const esc = (value) => String(value ?? '')
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    const map = L.map('map', { scrollWheelZoom: true }).setView([-14.5, -52.5], 4);
    L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}', {
      maxZoom: 16, attribution: 'Tiles &copy; Esri &mdash; Esri, HERE, Garmin',
    }).addTo(map);
    L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Reference/MapServer/tile/{z}/{y}/{x}', {
      maxZoom: 16,
    }).addTo(map);

    const status = document.getElementById('map-status');
    const list = document.getElementById('city-list');
    fetch('/api/live-map', { headers: { accept: 'application/json' } })
      .then((response) => {
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        return response.json();
      })
      .then((payload) => {
        const cities = Array.isArray(payload?.cities) ? payload.cities.flatMap((row) => {
          const lat = typeof row?.lat === 'number' ? row.lat : Number.NaN;
          const lon = typeof row?.lon === 'number' ? row.lon : Number.NaN;
          const city = typeof row?.city === 'string' ? row.city.trim() : '';
          const country = typeof row?.country === 'string' ? row.country.trim() : '';
          if (!city || !Number.isFinite(lat) || lat < -90 || lat > 90
            || !Number.isFinite(lon) || lon < -180 || lon > 180) return [];
          return [{
            city, country, lat, lon,
            matches: Math.max(0, Math.trunc(Number(row?.matches) || 0)),
            rounds: Math.max(0, Math.trunc(Number(row?.rounds) || 0)),
          }];
        }) : [];
        const maxMatches = Math.max(1, ...cities.map((city) => city.matches));
        for (const city of cities) {
          const marker = L.circleMarker([city.lat, city.lon], {
            radius: 6 + 18 * (city.matches / maxMatches),
            color: '#ffd23f', weight: 2, fillColor: '#ffd23f', fillOpacity: 0.25,
          }).addTo(map);
          marker.bindTooltip(`${esc(city.city)} · ${city.matches}`, {
            direction: 'top', offset: [0, -8], className: 'map-tip',
          });
          marker.bindPopup(
            `<b>${esc(city.city)}</b><br>${city.matches} partida${city.matches === 1 ? '' : 's'} · ${city.rounds} rounds`,
            { className: 'map-pop' },
          );

          const item = document.createElement('li');
          const name = document.createElement('strong');
          name.textContent = city.country ? `${city.city}, ${city.country}` : city.city;
          const total = document.createElement('span');
          total.textContent = `${city.matches} partida${city.matches === 1 ? '' : 's'} · ${city.rounds} rounds`;
          item.append(name, total);
          list.append(item);
        }
        status.textContent = cities.length ? `${cities.length} cidade${cities.length === 1 ? '' : 's'} no histórico.` : 'Ainda não há cidades no histórico.';
      })
      .catch(() => {
        status.textContent = 'Não foi possível carregar o mapa agora.';
      });
  </script>

  <section aria-labelledby="map-faq-title">
    <h2 id="map-faq-title">Entenda o mapa ao vivo</h2>
    {LIVE_MAP.faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
  </section>
</Layout>

<style>
  #map{height:520px;border:1px solid var(--line);background:var(--panel)}
  #map-status{font:12px var(--mono);color:var(--bone-dim)}
  .city-panel{margin:20px 0;padding:18px;border:1px solid var(--tp-borda);border-radius:12px;background:var(--panel)}
  .city-panel h2{margin-top:0}.city-panel ul{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px;margin:0;padding:0;list-style:none}
  .city-panel li{display:flex;justify-content:space-between;gap:12px;padding:10px;border-bottom:1px solid var(--line);font:12px var(--mono)}
  .city-panel li span{color:var(--bone-dim);text-align:right}
</style>
