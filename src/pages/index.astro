<!-- Settings - abas por categoria (padrão CS2/Valorant). Os IDs dos inputs NÃO mudam:
     toda a persistência/wiring do main.js continua valendo. -->
<div id="settings-panel" class="screen hidden" data-active-tab="video">
  <div class="panel settings-wrap">
    <div class="set-head">
      <h2>CONFIGURAÇÕES</h2>
      <button id="settings-close" class="set-close" type="button"><kbd>ESC</kbd> FECHAR</button>
    </div>
    <div class="set-tabs" role="tablist" aria-label="Categorias de configuração">
      <button class="set-tab active" data-tab="video" role="tab" aria-selected="true">VÍDEO</button>
      <button class="set-tab" data-tab="audio" role="tab" aria-selected="false">ÁUDIO</button>
      <button class="set-tab" data-tab="gameplay" role="tab" aria-selected="false">JOGABILIDADE</button>
      <button class="set-tab" data-tab="controls" role="tab" aria-selected="false">CONTROLES</button>
    </div>
    <div class="set-cols">
      <div class="set-list" role="tabpanel">
      <label class="set-row" data-section="video">QUALIDADE GRÁFICA
        <select id="set-quality">
          <option value="low">Batata (rápido)</option>
          <option value="med" selected>Média</option>
          <option value="high">Padrão ouro</option>
        </select>
      </label>
      <label class="set-row" data-section="controls">SENSIBILIDADE DO MOUSE
        <span class="set-range"><input id="set-sens" type="range" min="0.2" max="3" step="0.1" value="1"><b id="set-sens-val">1.0</b></span>
      </label>
      <label class="set-row" data-section="controls">INVERTER EIXO VERTICAL
