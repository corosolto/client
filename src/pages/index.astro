---
/* Módulos crus precisam mudar de URL no mesmo build em que o conteúdo muda. */
import { moduleCacheManifest } from '../../scripts/module-cache.mjs';
import pkg from '../../package.json';

const V = pkg.version;
const { modules: MODULOS, revision: JS_REV } = moduleCacheManifest();
const IMPORTMAP = JSON.stringify({
  imports: {
    three: `./vendor/three.module.js?v=${V}`,
    'three/addons/': './vendor/addons/',
    ...Object.fromEntries(MODULOS.map((m) => [`./js/${m}`, `./js/${m}?v=${V}-${JS_REV}`])),
  },
});
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<!-- Precisa rodar antes dos módulos para capturar falhas de boot; detalhes só com ?debug=1. -->
<script is:inline>
(function(){
  var TETO_SESSAO = 10;      // no máximo 10 erros DISTINTOS por carregamento de página
  var TETO_EXTERNO = 3;      // externos ficam no banco, mas com cota própria (BUG-51)
  var MIGALHAS = 20;         // últimas ações guardadas
  var DEBUG = new URLSearchParams(location.search).get('debug') === '1';
  var enviados = {}, corpos = {}, nEnviados = 0, nExternos = 0, migalhas = [], reportando = false;
  var relatorioFalha = null, falhaPendente = null, erroDoBoot = null;
  var inicio = Date.now();
  var consoleErroNativo = null;
  try { consoleErroNativo = console.error && console.error.bind(console); } catch(_) {}

  function showDebug(kind, msg, extra){
    if (!DEBUG) return;
    // O fallback WebGL já explica a falha; só o banner é suprimido, não o relatório.
    if (window.__semWebgl) return;
    try{
      var el = document.getElementById('crash-overlay');
      if(!el){
        el = document.createElement('div'); el.id = 'crash-overlay';
        el.style.cssText = 'position:fixed;left:0;right:0;bottom:0;max-height:45vh;overflow:auto;z-index:2147483647;background:rgba(120,0,0,.94);color:#fff;font:12px/1.45 ui-monospace,Menlo,monospace;padding:10px 14px;white-space:pre-wrap;border-top:2px solid #ff5252';
        el.onclick = function(){ el.remove(); };
        (document.body || document.documentElement).appendChild(el);
      }
      el.textContent = 'DEBUG (' + kind + '): ' + msg + (extra ? ('\n\n' + extra) : '') + '\n\n(clique para fechar)';
    }catch(_){}
  }

  /* Agrupa igual ao banco (migration 015): mensagem + origem viram uma chave, e o
     UPSERT lá vira `hits`. Sem isto, um erro dentro do requestAnimationFrame manda
     60 linhas por segundo. FNV-1a de 32 bits - não é criptografia, é balde. */
  function digital(s){
    var h = 2166136261;
    for (var i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = (h * 16777619) >>> 0; }
    return ('0000000' + h.toString(16)).slice(-8);
  }

  /* A versão sai do `?v=` do próprio HTML: ela já está aqui, já sobe junto no bump dos
     dois lados, e assim não há terceiro lugar para esquecer de atualizar. */
  function versao(){
    try{
      var l = document.querySelector('link[rel=stylesheet][href*="?v="]');
      return l ? (l.getAttribute('href').split('?v=')[1] || null) : null;
    }catch(_){ return null; }
  }

  /* Contexto de partida do `window.__game` (main.js:556 já o expõe). Tudo em try:
     ler contexto NUNCA pode ser o que derruba o relatório do erro de verdade. */
  function contexto(){
    var c = { version: versao(), route: location.pathname, breadcrumbs: migalhas.slice() };
    try{
      // 'cs_anon' é a MESMA chave do `ANON_KEY` de main.js:403 - sem isso o erro não
      // cruza com a telemetria do mesmo navegador, que é metade da utilidade.
      var a = localStorage.getItem('cs_anon');
      if (a) c.anonId = a;
    }catch(_){}
    try{
      var g = window.__game;
      if (g) {
        // `_mapId` (game.js:620) e NÃO `mapId`: o construtor recebe `mapId` e guarda
        // resolvido no campo com underscore. Ler o nome errado dá `undefined` calado -
        // o erro chegaria sem mapa e ninguém desconfiaria da coluna vazia.
        c.map = g._mapId || null;
        c.mode = g.ctf ? 'ctf' : 'rounds';
        c.faction = g.playerFaction || null;
        c.matchSecs = Math.round(g.time || 0);
        c.nick = g.nickname || null;
      } else {
        var n = document.getElementById('nick-input');
        if (n && n.value) c.nick = n.value.slice(0, 40);
      }
    }catch(_){}
    return c;
  }

  function reporta(kind, msg, source, stack, externa){
    if (reportando) return null;                           // guarda de laço
    try{
      var fp = digital(kind + '|' + (msg || '') + '|' + (source || ''));
      if (enviados[fp]) return { fp: fp, corpo: corpos[fp] || null }; // 1 envio automático por erro distinto
      if (!enviados[fp]) {
        if (externa) {
          if (nExternos >= TETO_EXTERNO) return null;
          nExternos++;
        } else {
          if (nEnviados >= TETO_SESSAO) return null;
          nEnviados++;
        }
        enviados[fp] = 1;
      }
      reportando = true;
      var c = contexto();
      c.fingerprint = fp; c.kind = kind;
      c.message = String(msg || '?').slice(0, 500);
      c.source = source || null;
      c.stack = stack ? String(stack).slice(0, 4000) : null;
      var corpo = JSON.stringify(c);
      corpos[fp] = corpo;
      /* sendBeacon sobrevive à aba fechando, que é justamente quando o jogador some
         depois de um crash. O clique manual usa fetch para poder confirmar o envio. */
      if (!(navigator.sendBeacon && navigator.sendBeacon('/api/jserror', new Blob([corpo], {type:'application/json'}))))
        fetch('/api/jserror', { method:'POST', headers:{'content-type':'application/json'}, body: corpo, keepalive: true }).catch(function(){});
      reportando = false;
      return { fp: fp, corpo: corpo };
    }catch(_){ /* coletor NUNCA atrapalha o jogo */ }
    reportando = false;
    return null;
  }

  function erroIgnoravel(r){
    var nome = r && r.name;
    var msg = String((r && r.message) || r || '');
    return nome === 'AbortError' || /media resource was aborted|fetching process.*aborted/i.test(msg);
  }
  /* URL http só prova origem em source/stack; na mensagem ela é payload do
     jogo ("falha ao carregar https://api..."). Esquema de extensão vale em
     qualquer campo: o navegador reporta frame injetado até na mensagem (#157). */
  function origemDoJogo(source, stack, mensagem){
    var sourceText = String(source || '');
    var extensao = /(?:chrome|moz|safari-web|safari)-extension:\/\//i;
    if (extensao.test(sourceText)) return false;
    var propria = location.origin;
    if (sourceText && /^https?:\/\//i.test(sourceText)) {
      try {
        if (new URL(sourceText, location.href).origin !== propria) return false;
        return true;
      } catch(_) {}
    }
    var prova = sourceText + '\n' + String(stack || '');
    var urls = prova.match(/https?:\/\/[^\s)'"<>]+/gi) || [];
    var viuPropria = false, viuExterna = false;
    for (var i = 0; i < urls.length; i++) {
      try {
        if (new URL(urls[i], location.href).origin === propria) viuPropria = true;
        else viuExterna = true;
      } catch(_) {}
    }
    if (viuPropria) return true;
    if (extensao.test(prova + '\n' + String(mensagem || ''))) return false;
    return !viuExterna;
  }

  function ligaFalha(){
    var el = document.getElementById('launch-error');
    if (!el || el.dataset.ready) return el;
    el.dataset.ready = '1';
    var retry = document.getElementById('launch-error-retry');
    var send = document.getElementById('launch-error-report');
    var status = document.getElementById('launch-error-status');
    if (retry) retry.onclick = function(){ location.reload(); };
    if (send) send.onclick = function(){
      send.disabled = true;
      send.textContent = 'ENVIANDO…';
      var envio;
      try {
        var corpo = relatorioFalha;
        envio = corpo
          ? fetch('/api/jserror', { method:'POST', headers:{'content-type':'application/json'}, body: corpo, keepalive: true })
              .then(function(r){ return r.ok; }, function(){ return false; })
          : Promise.resolve(false);
      } catch(_) { envio = Promise.resolve(false); }
      envio.then(function(ok){
        send.textContent = ok ? 'RELATÓRIO ENVIADO ✓' : 'TENTAR ENVIAR DE NOVO';
        send.disabled = !!ok;
        if (status) status.textContent = ok ? 'Valeu. Isso ajuda a gente a corrigir mais rápido.' : 'Não deu para enviar agora. Você ainda pode tentar novamente.';
      });
    };
    return el;
  }

  function mostraFalha(dados){
    var el = ligaFalha();
    if (!el) { falhaPendente = dados; return; }
    var code = document.getElementById('launch-error-code');
    if (code) code.textContent = dados.fp ? ('CÓDIGO ' + dados.fp.toUpperCase()) : 'RELATÓRIO LOCAL';
    el.classList.remove('hidden');
    try { document.getElementById('launch-error-retry').focus(); } catch(_){}
  }

  var lancamento = {
    ativo: false, etapa: null, timer: null,
    begin: function(etapa, timeout, concluiu){
      if (this.timer) clearTimeout(this.timer);
      this.ativo = true; this.etapa = etapa;
      var self = this;
      this.timer = setTimeout(function(){
        if (concluiu && concluiu()) { self.ready(etapa); return; }
        self.fail(new Error('tempo limite ao abrir ' + etapa), 'launch-watchdog');
      }, timeout || 12000);
    },
    ready: function(etapa){
      if (etapa && this.etapa && etapa !== this.etapa) return;
      if (this.timer) clearTimeout(this.timer);
      this.timer = null; this.ativo = false; this.etapa = null;
    },
    fail: function(err, source){
      var etapa = this.etapa || 'a arena';
      this.ready();
      var msg = (err && err.message) || String(err || 'falha desconhecida');
      var stack = err && err.stack;
      if (/watchdog$/.test(source || '') && consoleErroNativo) {
        try { consoleErroNativo('Falha ao abrir ' + etapa, err); } catch(_) {}
      }
      var registro = reporta('error', 'Falha ao abrir ' + etapa + ': ' + msg, source || 'launch', stack);
      relatorioFalha = registro && registro.corpo;
      mostraFalha({ fp: registro && registro.fp });
    }
  };
  window.__gameLaunch = lancamento;

  document.addEventListener('DOMContentLoaded', function(){
    ligaFalha();
    if (falhaPendente) { var f = falhaPendente; falhaPendente = null; mostraFalha(f); }
  });

  /* Migalhas: o que o jogador FEZ, nunca o que ele ESCREVEU. Clique em elemento com id
     ou em botão cobre o menu inteiro sem precisar instrumentar main.js linha a linha -
     e a regra "só rótulo, nunca conteúdo" está escrita na migration 015. */
  function migalha(txt){
    migalhas.push(new Date().toISOString().slice(11, 19) + ' ' + String(txt).slice(0, 120));
    if (migalhas.length > MIGALHAS) migalhas.shift();
  }
  window.__migalha = migalha;   // hook para quem quiser marcar passo de jogo
  document.addEventListener('click', function(e){
    try{
      var t = e.target && e.target.closest ? e.target.closest('button,[id],a') : null;
      if (t) migalha('clique ' + (t.id ? '#' + t.id : t.tagName.toLowerCase()));
    }catch(_){}
  }, true);

  window.addEventListener('error', function(e){
    var loc = e.filename ? (e.filename + ':' + e.lineno + ':' + e.colno) : '';
    var msg = (e.message || e.error || '?');
    var interna = origemDoJogo(e.filename, e.error && e.error.stack, String(msg));
    if (consoleErroNativo) {
      try { consoleErroNativo('Erro global não tratado', e.error || msg); } catch(_) {}
    }
    // A factory já registrou a falha final; o throw apenas interrompe o módulo sem renderer.
    if (window.__semWebgl && /sem_webgl/.test(String(msg))) return;
    if (interna) showDebug('error', msg + (loc ? ('  @ ' + loc) : ''), e.error && e.error.stack);
    reporta('error', msg, loc, e.error && e.error.stack, !interna);
    if (!window.__CS_MAIN_READY__ && interna) erroDoBoot = e.error || new Error(String(msg));
    if (lancamento.ativo && interna) lancamento.fail(e.error || new Error(String(msg)), loc);
  });
  window.addEventListener('unhandledrejection', function(e){
    var r = e.reason;
    var interna = origemDoJogo(null, r && r.stack, String((r && r.message) || r || ''));
    if (consoleErroNativo) {
      try { consoleErroNativo('Promise rejeitada sem tratamento', r); } catch(_) {}
    }
    if (interna) showDebug('promise', (r && r.message) || String(r), r && r.stack);
    reporta('promise', (r && r.message) || String(r), null, r && r.stack, !interna);
    if (lancamento.ativo && interna && !erroIgnoravel(r)) lancamento.fail(r instanceof Error ? r : new Error(String(r)), 'promise');
  });

  /* Um erro global sozinho não prova que o jogo parou (extensões de carteira injetam
     vários). A tela amigável nasce só de uma ação que prometia avançar e não avançou. */
  window.addEventListener('pointerdown', function(e){
    try{
      var alvo = e.target && e.target.closest ? e.target.closest('#boot-splash,#btn-jogar') : null;
      if (!alvo) return;
      if (alvo.id === 'boot-splash') {
        var prompt = document.getElementById('splash-enter');
        var pronto = prompt && !prompt.classList.contains('hidden');
        if (!window.__CS_MAIN_READY__ && (erroDoBoot || Date.now() - inicio > 22000)) {
          lancamento.fail(erroDoBoot || new Error('carregamento inicial não respondeu'), 'boot-watchdog');
        } else if (window.__CS_MAIN_READY__ || pronto) {
          lancamento.begin('entrada', 3000, function(){
            var splash = document.getElementById('boot-splash');
            return !splash || splash.classList.contains('gone');
          });
        }
      } else {
        lancamento.begin('menu', 3000, function(){
          var menu = document.getElementById('main-menu');
          var setup = document.getElementById('menu-setup');
          return !!(menu && menu.classList.contains('hidden')) || !!(setup && setup.dataset.step === 'profile');
        });
      }
    }catch(_){}
  }, true);

  /* console.error só ganha overlay em ?debug=1: nem todo console.error é crash, e
     tapar a tela do jogador com aviso de textura faltando seria pior que o aviso. Sem a
     flag ele apenas é reportado e agrupado igual aos outros.
     O original é chamado PRIMEIRO: se o relatório explodir, o log dele não se perde. */
  try{
    var orig = consoleErroNativo || console.error;
    console.error = function(){
      try{ orig.apply(console, arguments); }catch(_){}
      // Tentativas WebGL continuam no console, mas só a falha final vira relatório.
      if (window.__webglTentativa) return;
      try{
        var partes = [];
        for (var i = 0; i < arguments.length && i < 4; i++) {
          var a = arguments[i];
          partes.push(a && a.message ? a.message : String(a));
        }
        var m = partes.join(' ');
        showDebug('console', m, (arguments[0] && arguments[0].stack) || null);
        reporta('console', m, null, (arguments[0] && arguments[0].stack) || null);
      }catch(_){}
    };
  }catch(_){}
})();
</script>
