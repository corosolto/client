<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": "https://www.csbrasil.online/#faq",
  "mainEntity": [
    { "@type": "Question", "name": "O que é CORO SOLTO: Treta Suprema?",
      "acceptedAnswer": { "@type": "Answer", "text": "Um jogo FPS gratuito que roda no navegador: arena de sniper estilo praca_poderes do CS 1.6 ambientada numa Brasília fictícia e satírica. Tem 5 facções (Time E, Time B, Tribos Urbanas, Palhaços e Funkeiros), 44 personagens originais, 5 mapas, 26 armas, bots, sistema de rounds e Capture the Flag. O jogo já se chamou CS BRASIL." } },
    { "@type": "Question", "name": "Preciso instalar ou pagar algo?",
      "acceptedAnswer": { "@type": "Answer", "text": "Não. O jogo é 100% gratuito e roda direto no navegador de desktop (Chrome, Edge ou Firefox), sem download, sem instalação e sem cadastro." } },
    { "@type": "Question", "name": "Quais são os controles?",
      "acceptedAnswer": { "@type": "Answer", "text": "WASD move, mouse mira, clique esquerdo atira, clique direito abre a luneta, Ctrl (ou C) agacha e melhora a mira, Shift corre, Espaço pula, R recarrega, as teclas 1/2/3 trocam entre primária, pistola e faca, Z/X/V abrem os comandos de voz, M troca de time e Tab mostra o placar." } },
    { "@type": "Question", "name": "Quais são as facções e os personagens?",
      "acceptedAnswer": { "@type": "Answer", "text": "Cinco facções fictícias e satíricas, com 44 personagens no total: Time E (8), Time B (9), Tribos Urbanas (9), Palhaços (9) e Funkeiros (9). Tribos Urbanas e Funkeiros não têm nada de política. Todos são arquétipos originais, sem pessoas reais, e todos jogam exatamente igual." } },
    { "@type": "Question", "name": "Quais mapas o jogo tem?",
      "acceptedAnswer": { "@type": "Answer", "text": "Cinco arenas: Praça dos Três Poderes (a Brasília fictícia, com a urna gigante quebrada no mid), Praça clássica, Piscina da Treta, Loja H (estacionamento) e Ferro Velho do Zé. As duas últimas abrem em Capture the Flag, mas qualquer mapa aceita qualquer modo." } },
    { "@type": "Question", "name": "Tem ranking global?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ainda não. O jogo está em alpha e o ranking global está desligado até o placar ser confiável. Seus stats de partida ficam salvos no seu navegador e aparecem no menu RANKING do jogo." } },
    { "@type": "Question", "name": "É um jogo oficial da Valve ou do Counter-Strike?",
      "acceptedAnswer": { "@type": "Answer", "text": "Não. É uma paródia independente feita por fãs, sem qualquer afiliação com a Valve. Counter-Strike é marca da Valve Corporation." } },
    { "@type": "Question", "name": "Funciona no celular?",
      "acceptedAnswer": { "@type": "Answer", "text": "O jogo foi feito para desktop com mouse e teclado. Em telas de toque um aviso recomenda jogar no computador." } }
  ]
}
</script>
