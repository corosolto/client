      <label class="set-row" data-section="audio">VOLUME GERAL
        <span class="set-range"><input id="set-vol" type="range" min="0" max="1" step="0.05" value="0.7"><b id="set-vol-val">70%</b></span>
      </label>
      <label class="set-row" data-section="audio">FALAS DOS MEMES
        <span class="set-toggle"><input id="set-speech" type="checkbox" checked><b>LIGADO</b><i>DESLIGADO</i></span>
      </label>
      <label class="set-row set-extra" data-section="gameplay">IDIOMA
        <select id="set-lang">
