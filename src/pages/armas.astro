---
// /armas - página de conteúdo indexável do arsenal.
//
// POR QUE ELA EXISTE (SEO): "awp", "ak 47", "arma de fps de navegador" são
// buscas com volume real, e até agora o site não tinha UMA linha de texto sobre
// as 26 armas - a informação só existia dentro do JS do jogo, que buscador
// nenhum lê. É a página mais barata de escrever e a que mais amplia a
// superfície de long tail do domínio.
//
// AS IMAGENS (adicionadas em 05/08). Até aqui a página era texto puro: 26 armas
// descritas por número e nenhuma mostrada. As miniaturas de `/img/weapons/<id>.webp`
// NÃO são arte gerada - são renders dos MESMOS GLB que o jogo carrega, feitos por
// `tools/eval/weapon-shots.mjs` com o `weaponModel()` de `public/js/weapons.js`.
// Mesma câmera, mesma luz e MESMA CAIXA nas 26, então a escala entre elas é verdadeira:
// a Mosin (1,19 m) sai 4,9× mais comprida que o revólver (0,245 m) porque ela é.
// Regerar: `node tools/eval/serve.mjs 8123 &` e `node tools/eval/weapon-shots.mjs`.
import Layout from '../layouts/Layout.astro';
import { ARMAS, ARREMESSO } from '../data/jogo';
import { BRAND_FULL, GAME_ID, abs } from '../lib/site';

const classes = [...new Set(ARMAS.map(a => a.classe))];
const porClasse = classes.map(c => ({ classe: c, armas: ARMAS.filter(a => a.classe === c) }));

// A comparação começa por dano; os cabeçalhos permitem reordenar no cliente.
const danoPorDisparo = (a: typeof ARMAS[number]) => a.id === 'shotgun' ? a.dano * 9 : a.dano;
const armasOrdenadas = [...ARMAS].sort((a, b) => danoPorDisparo(b) - danoPorDisparo(a));

// Ordem de aparição na página, para decidir quem carrega `eager` e quem carrega `lazy`.
// Só as 3 primeiras estão acima da dobra em 1200×800 (medido na captura); as outras 23
// são 143 KB que não precisam competir com o LCP.
const ordem = new Map(porClasse.flatMap(g => g.armas).map((a, i) => [a.id, i]));

// ItemList com as 26 armas: dá ao crawler a lista inteira em forma estruturada,
// e é o formato que assistente de IA consegue citar sem alucinar número.
const jsonld = [
  {
    '@type': 'ItemList',
    '@id': abs('/armas') + '#lista',
    name: `Arsenal do ${BRAND_FULL}`,
    description: `As ${ARMAS.length} armas jogáveis: dano, pente, munição de reserva e cadência.`,
    numberOfItems: ARMAS.length,
    itemListOrder: 'https://schema.org/ItemListUnordered',
    itemListElement: ARMAS.map((a, i) => ({
      '@type': 'ListItem', position: i + 1, name: a.nome,
      description: `${a.classe} · ${a.dano} de dano · pente de ${a.pente}. ${a.nota}`,
    })),
  },
  // As duas de arremesso entram como lista PRÓPRIA, e não anexadas à lista das 26:
  // o número 26 é citado por assistente de IA a partir do `numberOfItems` acima, e
  // engordá-lo para 28 passaria a chamar fumaça de arma de fogo.
  {
    '@type': 'ItemList',
    '@id': abs('/armas') + '#arremesso',
    name: `Granadas do ${BRAND_FULL}`,
    description: `As ${ARREMESSO.length} de arremesso: quantidade por rodada, fusível e raio.`,
    numberOfItems: ARREMESSO.length,
    itemListOrder: 'https://schema.org/ItemListUnordered',
    itemListElement: ARREMESSO.map((a, i) => ({
      '@type': 'ListItem', position: i + 1, name: a.nome,
      description: `${a.quantidade} por rodada · fusível de ${a.fusivel} s · raio de ${a.raio} m. ${a.efeito}.`,
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'Armas', item: abs('/armas') },
    ],
  },
  { '@id': GAME_ID },
];
---
<Layout
  {/* og:image própria, gerada em runtime por /api/og/armas.png (issue #33) -
      antes caía na og-image.png genérica, igual pra todo o site. */}
  ogImage={abs('/api/og/armas.png')}
  ogImageAlt={`Card com o arsenal do ${BRAND_FULL}`}
  title={`Armas - as ${ARMAS.length} do arsenal | ${BRAND_FULL}`}
  description={`Todas as ${ARMAS.length} armas do ${BRAND_FULL}: AWP, AK-47, M4A1, MD97, Mosin, escopeta, SMGs e faca - com imagem, dano, pente, reserva e cadência de cada uma, mais as ${ARREMESSO.length} granadas.`}
  jsonld={jsonld}
  h1="Arsenal"
  kicker={`${ARMAS.length} armas · ${classes.length} classes · ${ARREMESSO.length} de arremesso`}
  heroImg="/img/map-previews/fy_havan.jpg"
  heroPos="66%">
  <Fragment slot="sub">
    {ARMAS.length} armas jogáveis, divididas em {classes.length} classes. Os números abaixo são os
    mesmos que o jogo usa em partida - dano por projétil, tamanho do pente, munição de reserva e o
    intervalo entre tiros em segundos. Troque de arma com <code>1</code> (primária),
    <code>2</code> (pistola) e <code>3</code> (faca) - e as duas granadas de arremesso no
    <code>4</code> (fumaça) e no <code>5</code> (fragmentação).
  </Fragment>

  <div class="panel">
    <strong style="color:var(--amber)">Como ler a tabela.</strong>
    <p style="margin-top:6px">
      <b>DANO</b> é por projétil que acerta o corpo - headshot multiplica, e a M3 dispara 9 bagos
      de {ARMAS.find(a => a.id === 'shotgun')?.dano} por tiro. <b>CAD.</b> é o intervalo entre
      disparos: quanto menor, mais rápido. A AWP mata com um tiro em qualquer lugar do corpo; é a
      única arma do jogo com essa propriedade, e é o que define o ritmo da arena.
    </p>
    <p style="margin-top:6px">
      <b>AS IMAGENS SÃO OS MODELOS DO JOGO</b>, renderizados do mesmo arquivo 3D que carrega
      em partida - não é ilustração. Todas foram tiradas com a mesma câmera e a mesma caixa,
      então o tamanho de uma comparado com a outra é o tamanho de verdade: a faca é aquele
      tiquinho ao lado da Mosin porque ela é 4,9× menor.
    </p>
  </div>

  <h2>Comparar todas · {ARMAS.length}</h2>
  <p style="color:var(--bone-dim);font-size:13px;margin:-4px 0 12px">
    Clique num cabeçalho pra ordenar por ele - clique de novo pra inverter. <b>DPS*</b> é
    dano ÷ cadência, teórico e sem contar recarga.
  </p>
  <div class="tw">
    <table id="armas-all-tbl">
      <thead>
        <tr>
          <th scope="col" data-key="arma"><button type="button">Arma</button></th>
          <th scope="col" data-key="classe"><button type="button">Classe</button></th>
          <th scope="col" class="num" data-key="dano" aria-sort="descending"><button type="button">Dano</button></th>
          <th scope="col" class="num" data-key="pente"><button type="button">Pente</button></th>
          <th scope="col" class="num" data-key="reserva"><button type="button">Reserva</button></th>
          <th scope="col" class="num" data-key="cadencia"><button type="button">Cad. (s)</button></th>
          <th scope="col" class="num" data-key="dps"><button type="button">DPS*</button></th>
        </tr>
      </thead>
      <tbody>
        {armasOrdenadas.map(a => {
          const danoPorTiro = danoPorDisparo(a);
          const dps = Math.round((danoPorTiro / a.cadencia) * 10) / 10;
          return (
            <tr data-arma={a.nome} data-classe={a.classe} data-dano={danoPorTiro}
              data-pente={a.pente} data-reserva={a.reserva} data-cadencia={a.cadencia}
              data-dps={dps}>
              <td>{a.nome}</td>
              <td>{a.classe}</td>
              <td class="num">{a.dano}{a.id === 'shotgun' ? ' ×9' : ''}</td>
              <td class="num">{a.pente || ' - '}</td>
              <td class="num">{a.reserva || ' - '}</td>
              <td class="num">{a.cadencia}</td>
              <td class="num">{dps}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  {porClasse.map(({ classe, armas }) => (
    <>
      <h2>{classe} · {armas.length}</h2>
      <div class="tw">
        <table>
          <thead>
            <tr>
              <th scope="col">Arma</th>
              <th scope="col" class="num">Dano</th>
              <th scope="col" class="num">Pente</th>
              <th scope="col" class="num">Reserva</th>
              <th scope="col" class="num">Cad. (s)</th>
            </tr>
          </thead>
          <tbody>
            {armas.map(a => (
              <>
                <tr class="top">
                  <td>
                    <img class="wshot" src={`/img/weapons/${a.id}.webp`}
                      width="360" height="138" alt={`Modelo 3D da ${a.nome} no jogo`}
                      loading={(ordem.get(a.id) ?? 99) < 3 ? 'eager' : 'lazy'}
                      decoding="async">
                    <strong>{a.nome}</strong></td>
                  <td class="num">{a.dano}{a.id === 'shotgun' ? ' ×9' : ''}</td>
                  <td class="num">{a.pente || ' - '}</td>
                  <td class="num">{a.reserva || ' - '}</td>
                  <td class="num">{a.cadencia}</td>
                </tr>
                <tr>
                  <td colspan="5" style="border-bottom:1px solid #1e1a0e;color:var(--bone-dim);font-size:12px;padding-top:0">
                    {a.nota}
                  </td>
                </tr>
              </>
            ))}
          </tbody>
        </table>
      </div>
    </>
  ))}

  <h2>Arremesso · {ARREMESSO.length}</h2>
  <p style="color:var(--bone-dim);font-size:13px;margin:-4px 0 12px">
    Não são armas de fogo e não aparecem na contagem de {ARMAS.length} acima, mas são jogáveis e
    estão no HUD de toda partida (o <code>💨</code> e o <code>🧨</code> no canto). Você recebe as
    duas no começo de cada rodada e elas <b>não passam pra rodada seguinte</b>.
  </p>
  <div class="tw">
    <table>
      <thead>
        <tr>
          <th scope="col">Granada</th>
          <th scope="col">Tecla</th>
          <th scope="col" class="num">Por rodada</th>
          <th scope="col" class="num">Fusível (s)</th>
          <th scope="col" class="num">Raio (m)</th>
        </tr>
      </thead>
      <tbody>
        {ARREMESSO.map(a => (
          <>
            <tr class="top">
              <td><strong>{a.nome}</strong></td>
              <td><code>{a.tecla}</code></td>
              <td class="num">{a.quantidade}</td>
              <td class="num">{a.fusivel}</td>
              <td class="num">{a.raio}</td>
            </tr>
            <tr>
              <td colspan="5" style="border-bottom:1px solid #1e1a0e;color:var(--bone-dim);font-size:12px;padding-top:0">
                <b style="color:var(--amber-dim)">{a.efeito}.</b> {a.nota}
              </td>
            </tr>
          </>
        ))}
      </tbody>
    </table>
  </div>

  <h2>Qual usar</h2>
  <ul>
    <li><strong>Começando:</strong> AK-47. Mata em 3 tiros no corpo e perdoa erro de posicionamento.</li>
    <li><strong>Ângulo longo:</strong> AWP na Praça dos Três Poderes, G3SG1 se você prefere não perder a mira entre tiros.</li>
    <li><strong>Espaço fechado (Piscina da Treta, Loja H):</strong> MP5, P90 ou a M3.</li>
    <li><strong>Só pra humilhar:</strong> faca. Você anda mais rápido com ela na mão.</li>
  </ul>

  <div class="cta-row">
    <a class="btn-cta" href="/">▶ Testar no jogo</a>
    <a class="btn-cta btn-2" href="/como-jogar">Como jogar</a>
  </div>
</Layout>

<script>
  // espelho do /weapons: usuário em EN cai na gêmea (mesmas regras do i18n.js)
  try {
    const q = new URLSearchParams(location.search).get('lang');
    const ls = localStorage.getItem('cs_lang');
    const lang = (q === 'pt' || q === 'en') ? q : (ls === 'pt' || ls === 'en') ? ls
      : (/^pt/i.test(navigator.language || '') ? 'pt' : 'en');
    if (lang === 'en') location.replace('/weapons');
  } catch { /* fica */ }
</script>

<script>
  const tbl = document.getElementById('armas-all-tbl');
  const tbody = tbl?.querySelector('tbody');
  if (tbl && tbody) {
    const ths = [...tbl.querySelectorAll('th[data-key]')].filter(el => el instanceof HTMLElement);
    let sortKey = 'dano';
    let sortDir = 'desc';

    const numeric = new Set(['dano', 'pente', 'reserva', 'cadencia', 'dps']);

    function aplicar() {
      if (!tbody) return;
      const linhas = [...tbody.querySelectorAll('tr')].filter(el => el instanceof HTMLElement);
      linhas.sort((a, b) => {
        const va = a.dataset[sortKey] ?? '';
        const vb = b.dataset[sortKey] ?? '';
        const cmp = numeric.has(sortKey) ? parseFloat(va) - parseFloat(vb) : va.localeCompare(vb, 'pt-BR');
        return sortDir === 'asc' ? cmp : -cmp;
      });
      linhas.forEach(tr => tbody.appendChild(tr));
      ths.forEach(th => th.setAttribute('aria-sort',
        th.dataset.key === sortKey ? (sortDir === 'asc' ? 'ascending' : 'descending') : 'none'));
    }

    ths.forEach(th => {
      const btn = th.querySelector('button');
      btn?.addEventListener('click', () => {
        const key = th.dataset.key;
        if (!key) return;
        sortDir = key === sortKey ? (sortDir === 'asc' ? 'desc' : 'asc') : 'desc';
        sortKey = key;
        aplicar();
      });
    });
  }
</script>

<style>
  /* A miniatura vive na PRIMEIRA coluna, acima do nome, e não numa coluna própria:
     `.tw table` já tem `min-width:640px` (Layout.astro:418), então uma sexta coluna
     empurraria o scroll horizontal do celular para ~820 px e o leitor de 390 px passaria
     a arrastar a tabela para ler o dano. Empilhada, a largura da tabela não muda.

     E empilhada é o que deixa a INCONSISTÊNCIA aparecer: 26 miniaturas alinhadas pela
     mesma borda esquerda, uma embaixo da outra, denunciam qualquer arma fora do ângulo
     do catálogo na hora. Numa grade de cartões isso se perde. */
  .wshot{display:block;width:180px;height:69px;max-width:100%;margin:0 0 2px -6px}
  /* 180×69 exibido a partir de um arquivo 360×138: 2× de densidade, que é o que mantém
     o cano - 2 px de espessura - sem serrilha em tela retina. `width`/`height` no HTML
     reservam a caixa antes do byte chegar (sem isso as 26 `lazy` fazem a página pular
     durante a rolagem, que é o pior efeito colateral de lazy-load). */
  td:has(> .wshot){padding-top:10px;min-width:196px}

  /* O botão preserva a semântica do `th`; `aria-sort` expõe a ordem sem depender de cor. */
  #armas-all-tbl th[data-key] button{background:none;border:0;padding:0;margin:0;
    font:inherit;color:inherit;text-align:inherit;text-transform:inherit;letter-spacing:inherit;
    display:block;width:100%;cursor:pointer;user-select:none}
  #armas-all-tbl th[data-key] button::after{content:'';margin-left:4px;opacity:.5}
  #armas-all-tbl th[data-key][aria-sort="ascending"] button::after{content:'▲';opacity:1}
  #armas-all-tbl th[data-key][aria-sort="descending"] button::after{content:'▼';opacity:1}
</style>
