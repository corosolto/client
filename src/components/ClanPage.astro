---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../lib/site';
const { clanId = '', clan = null } = Astro.props;
const membros = clan && Number.isSafeInteger(clan.member_count) ? `${clan.member_count} ${clan.member_count === 1 ? 'membro' : 'membros'}` : null;
const titulo = clan ? `[${clan.tag}] ${clan.name} · Clãs` : 'Clãs · CORO SOLTO';
const descricao = clan
  ? [typeof clan.description === 'string' && clan.description.trim() ? clan.description.trim().slice(0, 160) : `Clã [${clan.tag}] ${clan.name} na CORO SOLTO.`, membros].filter(Boolean).join(' · ')
  : 'Monte sua turma, convide amigos e leve a tag do seu clã para a arena.';
const jsonld = clan ? [{ '@type': 'Organization', name: clan.name, alternateName: `[${clan.tag}]`, url: `${SITE}/clans/${clan.id}`, ...(typeof clan.description === 'string' && clan.description.trim() ? { description: clan.description.trim() } : {}) }] : [];
---
<Layout title={titulo} description={descricao} jsonld={jsonld} noindex={Boolean(clanId) && !clan}
  h1="Clãs" kicker="SUA TURMA NA ARENA" heroImg="/img/wall-40.webp" heroPos="50% 28%">
  <span slot="sub">Junte os amigos e leve a tag do seu clã para o placar.</span>
  <div id="clans-app" data-clan-id={clanId}>
    <p id="clan-status" role="status" aria-live="polite"></p>
    <button id="clan-retry" type="button" hidden>Tentar novamente</button>

    <section id="clan-public" class="clan-card" hidden aria-label="Clã do convite"></section>
    <section id="clan-guest" class="clan-card" hidden>
      <h2>Seu perfil</h2>
      <p>Com conta, seu clã acompanha você em qualquer aparelho: <a href="/comunidade">entre pela Comunidade</a>.</p>
      <p>Sem conta, use o mesmo navegador em que você joga. Seu clã fica vinculado a este perfil.</p>
      <form id="clan-register">
        <label>Seu nick <input name="nick" required minlength="2" maxlength="32" pattern="[A-Za-z0-9_.\-一-鿿]{2,32}" autocomplete="nickname" /></label>
        <button type="submit">Salvar perfil</button>
      </form>
    </section>

    <fieldset id="clan-controls" hidden>
      <section id="clan-mine" class="clan-card" hidden aria-label="Meu clã"></section>
      <section id="clan-create-panel" class="clan-card" hidden>
        <h2>Crie seu clã</h2>
        <form id="clan-create">
          <label>Nome <input name="name" required minlength="3" maxlength="40" placeholder="Bonde da Lan House" /></label>
          <label>Tag <input name="tag" required minlength="2" maxlength="5" pattern="[A-Za-z0-9]{2,5}" placeholder="LAN" /></label>
          <label>Descrição <textarea name="description" maxlength="240" rows="3" placeholder="Apresente sua turma"></textarea></label>
          <button type="submit">Criar clã</button>
        </form>
      </section>
      <section id="clan-join-panel" class="clan-card" hidden>
        <h2>Você recebeu um convite</h2>
        <p>Ao entrar, a tag do clã aparece no seu perfil e nas próximas partidas.</p>
        <button id="clan-join" type="button">Entrar no clã</button>
      </section>
    </fieldset>

    <section id="clan-invite-panel" class="clan-card" hidden>
      <h2>Convide sua turma</h2>
      <p>Quem tiver este link pode entrar. Gerar outro link revoga o anterior.</p>
      <label>Link de convite <input id="clan-invite-link" readonly /></label>
      <button id="clan-copy" type="button">Copiar link</button>
    </section>
    <section id="clan-directory" aria-label="Clãs recentes">
      <h2>Clãs da comunidade</h2>
      <div id="clan-list"></div>
    </section>
  </div>
</Layout>
<script type="module" is:inline>import '/js/clans.js';</script>
<style is:global>
  #clans-app{max-width:1100px;margin:auto;padding:4px 0 60px}
  #clans-app h2{font-size:26px;margin:0 0 14px}#clans-app p{line-height:1.6}
  #clans-app fieldset{border:0;padding:0;margin:0;min-width:0}
  #clans-app .clan-card{position:relative;overflow:hidden;border:1px solid var(--tp-borda);border-radius:12px;background:linear-gradient(145deg,rgba(38,34,27,.9),rgba(19,20,24,.96));padding:24px;margin:18px 0;box-shadow:0 18px 48px rgba(0,0,0,.2)}
  #clans-app .clan-card:before{content:'';position:absolute;inset:0 auto 0 0;width:3px;background:var(--tp-lima)}
  #clans-app label{display:block;margin:14px 0;color:var(--tp-tinta-2);font-weight:700;font-size:14px;letter-spacing:.03em}
  #clans-app input,#clans-app textarea,#clans-app select{display:block;box-sizing:border-box;width:100%;max-width:620px;min-height:44px;margin-top:7px;padding:12px 14px;background:rgba(9,7,4,.8);border:1px solid var(--tp-borda-forte);border-radius:8px;color:var(--bone);font:inherit}
  #clans-app button{min-height:44px;background:var(--tp-lima);color:#111;border:0;border-radius:8px;padding:12px 20px;font-weight:800;cursor:pointer;margin:6px 8px 6px 0;transition:transform .18s var(--tp-ease-saida),filter .18s var(--tp-ease-saida)}
  #clans-app button:hover{transform:translateY(-2px);filter:brightness(1.08)}
  #clans-app button:disabled{opacity:.5;cursor:wait;transform:none}
  #clans-app button:focus-visible,#clans-app input:focus-visible,#clans-app textarea:focus-visible,#clans-app select:focus-visible{outline:2px solid var(--tp-lima);outline-offset:3px}
  #clans-app [hidden]{display:none!important}#clan-status{min-height:26px;color:var(--tp-lima);font:500 12px/1.5 var(--mono);letter-spacing:.08em;text-transform:uppercase}
  #clan-directory{margin-top:34px}#clan-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:14px}
  #clans-app .clan-actions{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-top:14px}#clans-app .clan-actions a{display:inline-flex;align-items:center;min-height:44px;margin-right:auto}#clans-app .clan-actions button{margin:0}
</style>
