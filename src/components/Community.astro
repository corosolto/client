---
import pkg from '../../package.json';
declare const __MANIFESTO_JS__: {revision:string};
const socialSrc=`/js/community.js?v=${pkg.version}-${__MANIFESTO_JS__.revision}`;
const {profileId='',tab='profile'}=Astro.props;
---
<section id="community" class="community" data-profile={profileId} data-tab={tab}>
  <header class="social-heading"><div><p class="social-kicker">CORO SOLTO · A TURMA DA TRETA</p><h1>Quem joga junto, volta.</h1></div><a class="social-button" href="/">▶ BORA JOGAR</a></header>
  <p id="social-status" class="social-status" role="status" aria-live="polite">Carregando a comunidade…</p>
  <section id="social-account" class="social-card" aria-label="Sua conta"></section>
  <nav class="social-tabs" aria-label="Comunidade">
    <button type="button" data-tab="profile">PERFIL</button><button type="button" data-tab="friends">AMIGOS</button><button type="button" data-tab="ranking">RANKING</button><button type="button" data-tab="notifications">AVISOS <span id="social-unread"></span></button><button type="button" data-tab="feed">RESENHA</button><button type="button" data-tab="settings">PRIVACIDADE</button>
  </nav>
  <div id="social-content" class="social-content" aria-busy="true"></div>
  <p class="social-footnote">Perfil e comunidade ficam no menu. Na arena, o foco é a treta.</p>
</section>
<script is:inline type="module" src={socialSrc}></script>
<style is:global>
.community{max-width:1060px;margin:0 auto;color:var(--fg,#eee6d5);font-family:var(--sans,system-ui)}
.social-heading{display:flex;align-items:center;justify-content:space-between;gap:20px;margin:28px 0}.social-heading h1{font-size:clamp(26px,4vw,42px);margin:8px 0}.social-kicker{font-size:12px;color:var(--amber,#ffd23f);letter-spacing:.13em}
.social-status{min-height:24px;color:var(--amber,#ffd23f)}.social-card{border:1px solid var(--line-hi,#655638);background:#161510;padding:20px;margin:14px 0}.social-card h2,.social-card h3{margin-top:0}.social-muted,.social-footnote{color:#c0b69f;font-size:14px;line-height:1.6}.social-tabs{display:flex;gap:6px;flex-wrap:wrap;margin:24px 0}.social-tabs button,.social-button,.community button{border:1px solid #6b603f;background:#242118;color:#f5e9cc;padding:10px 14px;cursor:pointer;font:inherit;text-decoration:none;display:inline-block}.social-tabs button[aria-current=true],.social-button{color:#161510;background:var(--amber,#ffd23f);font-weight:bold}.community button:disabled{opacity:.5;cursor:wait}.social-actions{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0}.social-danger{color:#ffb3a4!important}.social-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:12px;margin:22px 0}.social-stat{padding:14px;background:#252118;border-left:3px solid var(--amber,#ffd23f)}.social-stat strong{display:block;font-size:25px}.social-stat span{font-size:12px;color:#c8bda6}.social-avatar{width:76px;height:76px;object-fit:cover;border:2px solid var(--amber,#ffd23f)}.social-identity{display:flex;gap:16px;align-items:center}.social-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px}.social-field{display:block;margin:14px 0}.social-field input,.social-field textarea,.social-field select,.social-search input{display:block;box-sizing:border-box;width:100%;background:#0f100d;border:1px solid #796e50;color:#f3ebd8;padding:12px;margin-top:6px;font:inherit}.social-field textarea{min-height:90px}.social-search{display:flex;gap:10px;align-items:end;margin:16px 0}.social-search label{flex:1}.social-table-wrap{overflow-x:auto}.social-table{width:100%;border-collapse:collapse}.social-table th,.social-table td{text-align:left;border-bottom:1px solid #544c36;padding:12px 8px}.social-table a,.social-card a{color:var(--amber,#ffd23f)}.social-list{padding-left:22px;line-height:1.9}.social-card p{overflow-wrap:anywhere}#social-content{min-height:220px}.community :focus-visible{outline:3px solid #fff;outline-offset:3px}@media(max-width:600px){.social-heading{align-items:flex-start;flex-direction:column}.social-card{padding:15px}.social-tabs button{flex:1;font-size:12px}.social-grid{grid-template-columns:1fr}.social-search{flex-wrap:wrap}.social-search label{min-width:180px}}
</style>
