---
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import { SITE, BRAND_FULL, abs, routeOgPath } from '../lib/site';
import { LEGAL_CONTACT, LEGAL_OPERATOR, LEGAL_UPDATED } from '../lib/legal';
import pkg from '../../package.json';
declare const __MANIFESTO_JS__: { revision: string };
const V = pkg.version;
const JS_REV = __MANIFESTO_JS__.revision;
interface Props { title: string; description: string; noindex?: boolean; }
const { title, description, noindex = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = new URL(path, Astro.site ?? SITE).toString();
const cssRevision = createHash('sha1').update(readFileSync('public/style.css')).digest('hex').slice(0, 8);
---
<!DOCTYPE html>
<html lang="pt-BR" data-home-ui="hub" data-ui="v3" class="legal-document">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | CORO SOLTO</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | CORO SOLTO`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={BRAND_FULL} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:image" content={abs(routeOgPath(path, title))} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} · ${BRAND_FULL}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="stylesheet" href={`/style.css?v=${cssRevision}`} />
    <script type="module" src={`/js/site-visit.js?v=${V}-${JS_REV}`} is:inline></script>
    <script is:inline>
      if (window.self !== window.top && new URLSearchParams(location.search).get('embed') === '1') document.documentElement.dataset.embedded = 'true';
    </script>
  </head>
  <body>
    <a class="skip-link" href="#documento">Ir para o documento</a>
    <header class="legal-header">
      <a href="/" aria-label="CORO SOLTO - voltar ao jogo"><img class="hub-logo" src="/logo.png" alt="CORO SOLTO: Treta Suprema" width="160" height="96" /></a>
      <nav aria-label="Documentos do jogo">
        <a href="/privacidade" aria-current={path === '/privacidade' ? 'page' : undefined}>Privacidade</a>
        <a href="/termos" aria-current={path === '/termos' ? 'page' : undefined}>Termos de uso</a>
        <a href="/excluir-dados" aria-current={path === '/excluir-dados' ? 'page' : undefined}>Excluir dados</a>
        <a href="/regras-de-uso" aria-current={path === '/regras-de-uso' ? 'page' : undefined}>Regras de uso</a>
      </nav>
      <a class="legal-play hub-cta" href="/">VOLTAR AO JOGO ↗</a>
    </header>
    <main id="documento" tabindex="-1">
      <div class="legal-heading">
        <h1>{title}</h1>
        <p class="updated">Atualizado em {LEGAL_UPDATED}</p>
      </div>
      <article class="legal-content">
        <aside class="legal-contact">
          <h2>Responsável e contato</h2>
          <p>{LEGAL_OPERATOR}.</p>
          <p>Suporte, privacidade e revisão de decisões:</p>
          <a href={`mailto:${LEGAL_CONTACT}`}>{LEGAL_CONTACT}</a>
        </aside>
        <div class="legal-text"><slot /></div>
      </article>
    </main>
    <footer class="legal-footer"><span>CORO SOLTO: TRETA SUPREMA</span><a href="/">VOLTAR AO JOGO ↗</a></footer>
  </body>
</html>
<style>
  :global(html.legal-document), :global(.legal-document body) { height: auto; min-height: 100%; overflow: auto; background: radial-gradient(900px 520px at 100% 0%,rgba(180,217,46,.1),transparent 70%),radial-gradient(720px 500px at 0 100%,rgba(243,185,88,.08),transparent 70%),var(--tp-asfalto,#090704); }
  :global(.legal-document *) { user-select: text; }
  :global(html.legal-document[data-embedded="true"]), :global(html.legal-document[data-embedded="true"] body) { min-height: 0; background: transparent; }
  :global(html[data-embedded="true"]) .legal-header, :global(html[data-embedded="true"]) .legal-footer, :global(html[data-embedded="true"]) .skip-link { display: none; }
  :global(html[data-embedded="true"]) main { max-width: none; padding: 0 0 24px; }
  :global(.legal-document body) { --legal-accent: var(--tp-lima,#b4d92e); --font: var(--tp-ui,'Barlow Semi Condensed',system-ui,sans-serif); font-family: var(--font); font-weight: 500; color: var(--tp-tinta-2,#d3d3d1); }
  a { color: var(--tp-lima,#b4d92e); text-underline-offset: 4px; }
  a:focus-visible { outline: var(--focus-ring); outline-offset: 4px; }
  .skip-link { position: absolute; left: 16px; top: -80px; z-index: 10; padding: 12px; background: var(--bg-600); }
  .skip-link:focus { top: 12px; }
  .legal-header { display: flex; align-items: center; gap: 28px; padding: 8px max(24px, calc((100vw - 1200px) / 2)); border-bottom: 1px solid var(--tp-borda,rgba(255,255,255,.08)); background: rgba(9,7,4,.9); backdrop-filter:blur(12px) }
  .hub-logo { display: block; height: 68px; }
  nav { display: flex; flex-wrap: wrap; gap: 24px; }
  nav a { min-height:44px;display:inline-flex;align-items:center;padding: 0; color: var(--tp-tinta-2,#d3d3d1); font:400 18px/1 var(--tp-display,Impact,sans-serif); text-decoration: none; text-transform: uppercase; letter-spacing: .03em; border-bottom: 3px solid transparent; }
  nav a[aria-current="page"] { color: var(--legal-accent); border-color: var(--legal-accent); }
  .legal-play { display: grid; place-items: center; width: auto; min-width: 190px; min-height:48px;padding: 0 20px; margin-left: auto; background:var(--tp-lima,#b4d92e);color: #131313; text-decoration: none; font:400 21px/1 var(--tp-display,Impact,sans-serif);clip-path:polygon(0 0,100% 0,100% calc(100% - 10px),calc(100% - 10px) 100%,0 100%)}
  .legal-play:focus-visible { outline: 0; box-shadow: inset 0 0 0 3px #131313; }
  main { max-width: 1200px; margin: 0 auto; padding: 54px 24px 72px;animation:legal-in .35s var(--tp-ease-saida,cubic-bezier(.2,.8,.2,1)) both}
  @keyframes legal-in{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
  .legal-heading { margin-bottom: 34px; }
  h1 { margin: 12px 0; color: var(--tp-tinta-1,#f0f0ed); font: 400 clamp(48px, 7vw, 88px)/.92 var(--tp-display,Impact,sans-serif); text-transform: uppercase; }
  .updated { color: var(--tp-tinta-3,#a5a5a3); font:500 12px/1.4 var(--tp-num,monospace);letter-spacing:.12em;text-transform:uppercase }
  .legal-content { display: grid; grid-template-columns: 260px minmax(0, 1fr); gap: 24px; align-items: start; }
  .legal-contact { border:1px solid var(--tp-borda,rgba(255,255,255,.08));border-radius:12px; padding: 20px; background: var(--tp-painel,#131418); font-size: 17px; line-height: 1.6; overflow-wrap: anywhere; }
  .legal-contact h2 { color: var(--tp-lima,#b4d92e); font:400 24px/1 var(--tp-display,Impact,sans-serif); margin-bottom: 16px;text-transform:uppercase }
  .legal-contact p { margin-bottom: 16px; }
  .legal-text { border:1px solid var(--tp-borda,rgba(255,255,255,.08));border-radius:14px;padding: 12px 28px 28px;background:rgba(19,20,24,.86); font-size: 19px; line-height: 1.65; overflow-wrap: anywhere; }
  .legal-text :global(h2) { margin: 36px 0 12px; color: var(--tp-tinta-1,#f0f0ed); font:400 28px/1 var(--tp-display,Impact,sans-serif);text-transform:uppercase }
  .legal-text :global(p) { margin-bottom: 16px; }
  .legal-text :global(ul), .legal-text :global(ol) { padding-left: 24px; margin-bottom: 20px; }
  .legal-text :global(li) { margin-bottom: 10px; }
  .legal-text :global(a) { color: var(--tp-lima,#b4d92e); text-decoration: underline; text-underline-offset: 4px; }
  .legal-text :global(a.legal-request) { display: inline-grid; place-items: center; width: auto; min-height:44px;padding: 0 20px; margin: 4px 0 20px; background:var(--tp-lima,#b4d92e);color: #131313; text-decoration: none; font-weight:800;border-radius:8px}
  .legal-text :global(a.legal-request:focus-visible) { outline: 0; box-shadow: inset 0 0 0 3px #131313; }
  .legal-footer { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 20px; border-top: 1px solid var(--tp-borda,rgba(255,255,255,.08)); padding: 24px max(24px, calc((100vw - 1152px) / 2)); color: var(--tp-tinta-3,#a5a5a3); font: 12px/1.5 var(--tp-num,monospace); }
  @media (max-width: 760px) {
    .legal-header { flex-wrap: wrap; gap: 16px; padding: 12px 20px; }
    .hub-logo { height: 64px; max-width: 100px; }
    nav { order: 3; width: 100%; gap: 24px; }
    .legal-play { min-width: 0; font-size: 20px; padding: 10px 14px; }
    main { padding: 32px 20px 48px; }
    .legal-content { grid-template-columns: minmax(0, 1fr); gap: 24px; }
    .legal-contact { padding: 16px; }
    .legal-text { font-size: 19px; }
  }
  @media(prefers-reduced-motion:reduce){main{animation:none}}
</style>
