---
import { SITE, BRAND, BRAND_FULL, BRAND_ALT, DESC_SHORT, ORG_ID, WEBSITE_ID, abs, RANKING_ON, DISCORD_URL, TELEGRAM_URL, GITHUB_URL } from '../lib/site';
import { PT_EN_PAIRS } from '../lib/i18n-pairs';
import pkg from '../../package.json';
declare const __MANIFESTO_JS__: { revision: string };
const V = pkg.version;
const JS_REV = __MANIFESTO_JS__.revision;

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  /** dimensões da og:image. Sem elas o card fica em branco no primeiro
   *  compartilhamento, enquanto o crawler da rede não baixou a imagem -
   *  https://developers.facebook.com/docs/sharing/webmasters/images */
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogType?: string;
  /** nós JSON-LD extras da página (ItemList, HowTo, ProfilePage…) */
  jsonld?: unknown[];
  noindex?: boolean;
  /* ---- abertura de página (.phead). Ver o bloco 3 do comentário do topo. ----
     `h1` fica AQUI e não no slot pra garantir que as 8 páginas abram do mesmo
     jeito: uma etiqueta, um título, um parágrafo. O texto rico da chamada entra
     pelo slot `sub`, porque metade das páginas usa <strong> dentro dele. */
  h1?: string;
  /** etiqueta âmbar do canto, no formato da referência: "05 ARENAS · CTF E ROUNDS" */
  kicker?: string;
  /** imagem DO JOGO usada como fundo da faixa de abertura */
  heroImg?: string;
  /** foco vertical do recorte do fundo (padrão 58%, que evita o céu estourado) */
  heroPos?: string;
}
const {
  title,
  description = DESC_SHORT,
  ogImage = abs('/og-image.jpg'),
  ogImageAlt = `${BRAND_FULL} - FPS satírico de navegador com facções brasileiras`,
  ogImageWidth = 1200,
  ogImageHeight = 630,
  ogType = 'website',
  jsonld = [],
  noindex = false,
  h1,
  kicker,
  heroImg,
  heroPos = '58%',
} = Astro.props;
const temSub = Astro.slots.has('sub');

// CANONICAL: normaliza a barra final. Sem isso, /ranking e /ranking/ emitem dois
// canonicals diferentes e o buscador trata como duas páginas - o mesmo tipo de
// diluição que o host sem `www` causava (ver astro.config.mjs).
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = new URL(path, Astro.site ?? SITE).toString();

const ptToEn = new Map<string, string>(PT_EN_PAIRS.map(([pt, en]) => [pt, en]));
const enToPt = new Map<string, string>(PT_EN_PAIRS.map(([pt, en]) => [en, pt]));
const pairedEn = ptToEn.get(path);
const pairedPt = enToPt.get(path);
const pageLang = pairedPt ? 'en' : 'pt-BR';
const ogLocale = pageLang === 'en' ? 'en_US' : 'pt_BR';
const hreflangPt = pairedPt ? new URL(pairedPt, Astro.site ?? SITE).toString() : canonical;
const hreflangEn = pairedEn ? new URL(pairedEn, Astro.site ?? SITE).toString() : pairedPt ? canonical : null;

// JSON-LD de site: emitido UMA vez, aqui, com @id estável. As páginas que
// precisam de nó próprio passam por `jsonld` e referenciam o jogo por @id em
// vez de repetir o objeto VideoGame inteiro - era o que sobre.astro fazia, e
// dois nós VideoGame com a mesma url e sem @id confundem a deduplicação.
const baseGraph = [
  { '@type': 'WebSite', '@id': WEBSITE_ID, url: SITE + '/', name: BRAND_FULL,
    alternateName: [BRAND, BRAND_ALT], inLanguage: 'pt-BR',
    publisher: { '@id': ORG_ID } },
  /* `logo` é a MARCA ISOLADA, não o cartão de compartilhamento. Apontava para
     `og-image.jpg` - que é paisagem 1200×630 com texto e cena - e schema.org
     pede a marca (https://schema.org/logo). `/logo.png` é o lockup em PNG com
     alfa, 651×526, e é o mesmo arquivo que o topo do site usa. */
  { '@type': 'Organization', '@id': ORG_ID, name: `${BRAND} contributors`,
    url: SITE + '/', logo: abs('/logo.png') },
];

/* NÓ DE PÁGINA (WebPage).
   Faltava: as páginas emitiam ItemList, HowTo, AboutPage e BreadcrumbList, mas
   nenhum nó dizendo "esta URL é uma página, e ela pertence a este site". Sem
   ele o grafo tem entidades soltas sem dono, e `mainEntityOfPage` não tem em
   que ancorar. schema.org: WebPage é o tipo do próprio documento
   (https://schema.org/WebPage).

   NÃO emitimos se a página já trouxe um nó do próprio tipo dela - AboutPage
   (/sobre) e ProfilePage (/u/*) SÃO subtipos de WebPage, e dois nós de página
   pra mesma URL é o mesmo defeito de deduplicação que os dois `VideoGame`
   causavam antes do `@id` estável. FAQPage fica FORA desta lista de propósito:
   em /como-jogar ela é uma seção da página (`#faq`), não o documento. */
const PAGE_NODE_TYPES = new Set([
  'WebPage', 'AboutPage', 'ProfilePage', 'CollectionPage', 'ItemPage',
  'QAPage', 'ContactPage', 'SearchResultsPage',
]);
const hasOwnPageNode = (jsonld as { '@type'?: string | string[] }[]).some((n) => {
  const t = n?.['@type'];
  return Array.isArray(t) ? t.some((x) => PAGE_NODE_TYPES.has(x)) : !!t && PAGE_NODE_TYPES.has(t);
});
const pageGraph = hasOwnPageNode ? [] : [{
  '@type': 'WebPage',
  '@id': canonical + '#webpage',
  url: canonical,
  name: title,
  description,
  inLanguage: pageLang,
  isPartOf: { '@id': WEBSITE_ID },
  primaryImageOfPage: {
    '@type': 'ImageObject', url: ogImage,
    width: ogImageWidth, height: ogImageHeight,
  },
}];
const jsonldLang = (jsonld as { '@type'?: string | string[]; inLanguage?: string }[]).map((n) => {
  const t = n?.['@type'];
  const types = Array.isArray(t) ? t : t ? [t] : [];
  if (types.some((x) => PAGE_NODE_TYPES.has(x)) && !n.inLanguage) return { ...n, inLanguage: pageLang };
  return n;
});

// O /ranking sai do nav enquanto RANKING_ON for false (src/lib/site.ts). A página
// continua respondendo - só deixa de ser oferecida, pra ninguém clicar num aviso.
const NAV: [string, string][] = [
  ['/comunidade','COMUNIDADE'] as [string,string],
  ['/clans', 'CLÃS'],
  ...(RANKING_ON ? [['/ranking', 'RANKING'] as [string, string]] : []),
  ['/personagens', 'PERSONAGENS'],
  ['/mapas', 'MAPAS'],
  ['/armas', 'ARMAS'],
  ['/como-jogar', 'COMO JOGAR'],
  ['/mapa', 'AO VIVO'],
  ['/sobre', 'SOBRE O JOGO'],
  ['/changelog', 'NOVIDADES'],
  ['/apoie', 'APOIE'],
];
const labelsEn: Record<string, string> = { '/ranking': 'LEADERBOARD', '/mapa': 'LIVE MAP', '/apoie': 'SUPPORT', '/personagens': 'CHARACTERS', '/mapas': 'MAPS', '/armas': 'WEAPONS', '/como-jogar': 'HOW TO PLAY', '/sobre': 'ABOUT THE GAME', '/changelog': 'WHAT’S NEW' };
const navigation = NAV.map(([href, label]) => ({ href: pageLang === 'en' ? ptToEn.get(href) ?? href : href, label: pageLang === 'en' ? labelsEn[href] ?? label : label, active: path === href || pairedPt === href || (href === '/personagens' && path.startsWith('/faccoes/')) }));
const playHref = pageLang === 'en' ? '/?lang=en' : '/?lang=pt';
const currentLabel = h1 ?? title.split(' | ')[0];

---
<!DOCTYPE html>
<html lang={pageLang}>
<head>
<link rel="preload" as="script" href={`/js/privacy-runtime.js?v=${V}-${JS_REV}`} />
<script src={`/js/privacy-runtime.js?v=${V}-${JS_REV}`} is:inline></script>
{import.meta.env.DEV && import.meta.env.SOCIAL_LOCAL_GAME_URL && <meta name="cs-local-game" content={import.meta.env.SOCIAL_LOCAL_GAME_URL} />}
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
{/* Fonte ÚNICA do hreflang - página nenhuma declara alternate por conta própria.
    Auto-referência é obrigatória e as URLs vêm do canonical (www, sem barra final). */}
<link rel="alternate" hreflang="pt-BR" href={hreflangPt}>
{hreflangEn && <link rel="alternate" hreflang="en" href={hreflangEn}>}
<link rel="alternate" hreflang="x-default" href={hreflangPt}>
{noindex && <meta name="robots" content="noindex, follow">}
{import.meta.env.GOOGLE_SITE_VERIFICATION && (
  <meta name="google-site-verification" content={import.meta.env.GOOGLE_SITE_VERIFICATION}>
)}
<meta name="theme-color" content="#090704">
<meta property="og:type" content={ogType}>
<meta property="og:site_name" content={BRAND_FULL}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content={String(ogImageWidth)}>
<meta property="og:image:height" content={String(ogImageHeight)}>
<meta property="og:image:alt" content={ogImageAlt}>
<meta property="og:locale" content={ogLocale}>
{hreflangEn && <meta property="og:locale:alternate" content={pageLang === 'en' ? 'pt_BR' : 'en_US'}>}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage}>
<meta name="twitter:image:alt" content={ogImageAlt}>
{/* O favicon TEM que ser declarado aqui. Antes havia um <link rel="icon"> com um
    SVG em data: URI (uma mira improvisada), e link declarado sempre ganha do
    `/favicon.ico` implícito - por isso o ícone de marca não aparecia na aba
    mesmo depois de o arquivo entrar no repo. */}
<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<!-- Espelhos em texto puro pros crawlers de resposta. `/llms.txt` é a proposta
     de llmstxt.org; `/llms-full.txt`, `/docs.json` e `/ai-index.json` e os
     espelhos `.md` são gerados no build (scripts/aeo.mjs, via aeo.js).
     HIPÓTESE, não fato: NÃO existe especificação que obrigue crawler nenhum a
     ler `rel="alternate" type="text/plain"` - nenhuma documentação de Google,
     OpenAI ou Anthropic promete isso hoje. As tags custam 4 linhas e tornam os
     arquivos descobríveis a partir do HTML; o ganho é declaradamente aposta. -->
<link rel="alternate" type="text/plain" href={abs('/llms.txt')} title="Resumo do site em texto (llms.txt)">
<link rel="alternate" type="text/plain" href={abs('/llms-full.txt')} title="Conteúdo completo em texto">
<link rel="alternate" type="application/json" href={abs('/ai-index.json')} title="Índice do site para IA">
<script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': [...baseGraph, ...pageGraph, ...jsonldLang] }).replace(/</g, '\\u003c')} />
<script is:inline>
  if (window.self !== window.top && new URLSearchParams(location.search).get('embed') === '1') document.documentElement.dataset.embedded = 'true';
</script>
<slot name="head" />
<style is:global>
@font-face{font-family:'Barlow Condensed';src:url('/fonts/barlowcondensed-400.woff2') format('woff2');font-weight:400;font-display:swap}
@font-face{font-family:'Barlow Condensed';src:url('/fonts/barlowcondensed-700.woff2') format('woff2');font-weight:700;font-display:swap}
@font-face{font-family:'Bebas Neue';src:url('/fonts/bebasneue-400.woff2') format('woff2');font-weight:400;font-display:swap}
@font-face{font-family:'ST Mono';src:url('/fonts/share-tech-mono.woff2') format('woff2');font-display:swap}
:root{--amber:#f3b958;--amber-dim:#c89b52;--amber-hi:#ffd479;--amber-soft:#f3b95812;--lime:#b4d92e;
  --bone:#f0f0ed;--bone-dim:#bcbab6;--ink:#f0f0ed;--bg:#090704;--panel:#0d0e11ed;--panel-2:#111214f5;
  --line:#34302b;--line-hi:#625440;--red:#e03232;--green:#46e08a;--purple:#a07bd6;--yellow:var(--amber);--dark:var(--bg);--cs:var(--lime);
  --font:'Barlow Condensed','Arial Narrow',Arial,sans-serif;--mono:'ST Mono',Consolas,monospace;--topo:104px}
*{margin:0;padding:0;box-sizing:border-box}
html{background:var(--bg);scroll-behavior:smooth}
body{color:var(--bone);font-family:var(--font);line-height:1.5;-webkit-font-smoothing:antialiased;min-height:100dvh;display:flex;flex-direction:column}
a{color:var(--amber)}img{max-width:100%}
:focus-visible{outline:2px solid var(--lime);outline-offset:4px}
main:focus-visible{outline:none}
.skip{position:fixed;left:-9999px;top:0;z-index:100;background:var(--lime);color:#131313;padding:12px 18px;font-weight:700;text-decoration:none}
.skip:focus{left:8px;top:8px}
.game-wallpaper{position:fixed;inset:0;pointer-events:none;background:linear-gradient(90deg,#090704f5,#090704d9 52%,#090704c9),linear-gradient(0deg,#090704fa,transparent 60%),url('/img/wall-16.webp') center/cover;z-index:0}
body>header,main,body>footer{position:relative;z-index:1}
body>header{display:flex;align-items:center;gap:22px;padding:10px max(24px,calc((100vw - 1440px)/2));min-height:var(--topo);position:sticky;top:0;z-index:10;background:#090704ed;backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
.brand{flex:none}.brand-logo{display:block;height:78px;width:auto;filter:drop-shadow(0 2px 6px #000b)}
.game-nav{display:flex;align-items:center;gap:14px;min-width:0;overflow-x:auto;scrollbar-width:thin;scrollbar-color:#625440 transparent}.game-nav::-webkit-scrollbar{height:3px}.game-nav::-webkit-scrollbar-thumb{background:#625440}
.game-nav a{flex:none;text-decoration:none;font-weight:700;font-size:15px;letter-spacing:.8px;white-space:nowrap;color:var(--bone-dim);padding:12px 0;border-bottom:2px solid transparent}
.game-nav a:hover{color:var(--bone);border-color:var(--amber)}
.game-nav a[aria-current='page']{color:var(--lime);border-color:var(--lime)}
.btn-play,.btn-cta{display:inline-block;background:linear-gradient(180deg,#cfe84a,var(--lime));color:#131313;text-decoration:none;font-weight:700;letter-spacing:1px;padding:12px 24px;white-space:nowrap;border:1px solid var(--lime);transition:filter .15s}
.btn-play{margin-left:auto;flex:none}.btn-play:hover,.btn-cta:hover{filter:brightness(1.1)}
.head-social{display:flex;gap:8px}.head-social a{color:var(--bone-dim);display:grid;place-items:center;width:30px;height:36px}.head-social svg{width:18px;height:18px;fill:currentColor}.head-social a:hover{color:var(--lime)}
main{width:100%;padding:20px 24px 56px;margin:0;flex:1;scroll-margin-top:var(--topo);min-width:0}
.shell-toolbar{display:flex;justify-content:space-between;align-items:center;gap:16px;margin-bottom:24px;font:400 11px/1.4 var(--mono);letter-spacing:1px;color:var(--bone-dim);text-transform:uppercase}
.shell-toolbar a{text-decoration:none}.shell-location{display:flex;gap:10px;min-width:0}.shell-location span:last-child{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.shell-tools{display:flex;gap:20px;flex:none}.shell-tools a:last-child{color:var(--lime)}
h1{font:400 clamp(40px,5vw,68px)/.95 'Bebas Neue',Impact,sans-serif;letter-spacing:1.2px;text-transform:uppercase;color:var(--ink);margin:10px 0 14px}
h2{color:var(--amber);font:700 22px/1.2 var(--font);letter-spacing:1px;text-transform:uppercase;margin:32px 0 14px;border-bottom:1px solid var(--line);padding-bottom:8px;scroll-margin-top:calc(var(--topo) + 16px)}
h3{color:var(--ink);font-size:20px;letter-spacing:.7px;text-transform:uppercase;margin:18px 0 6px}
p,li{font-size:18px;color:#d3d3d1}p{max-width:85ch}ul,ol{padding-left:24px}li{margin:8px 0}code{font:400 .8em var(--mono);color:var(--amber);background:var(--amber-soft);padding:2px 5px}hr{border:0;border-top:1px solid var(--line);margin:28px 0}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.phead{position:relative;overflow:hidden;margin-bottom:24px;padding:38px 28px 30px;border:1px solid var(--line);background:var(--panel-2);min-height:220px;display:flex;align-items:center}
.phead-art{position:absolute;right:0;top:0;bottom:0;width:46%;background:linear-gradient(90deg,#111214,transparent 65%),linear-gradient(0deg,#111214b0,transparent),var(--hero,none) center var(--heropos,58%)/cover;opacity:.8}
.phead-in{position:relative;width:100%;max-width:60%}.phead.semarte{min-height:0}.phead.semarte .phead-in{max-width:100%}
.kicker{position:absolute;top:18px;left:28px;z-index:1;color:var(--amber);font:400 10px/1.4 var(--mono);letter-spacing:1.8px;text-transform:uppercase;max-width:calc(100% - 56px)}
.sub{font-size:19px;max-width:60ch;color:var(--bone-dim)}
.panel{background:var(--panel);border:1px solid var(--line);border-left:3px solid var(--amber);padding:18px 22px;margin:12px 0}
.grid{display:grid;gap:16px}.grid.c2{grid-template-columns:repeat(auto-fit,minmax(300px,1fr))}.grid.c3{grid-template-columns:repeat(auto-fit,minmax(220px,1fr))}.grid.cards{grid-template-columns:repeat(auto-fill,minmax(340px,1fr))}
.card{display:flex;flex-direction:column;background:var(--panel);border:1px solid var(--line)}.card:hover{border-color:var(--line-hi)}
.card-body{padding:20px;display:flex;flex-direction:column;gap:8px;flex:1}.card-body>p{margin:0}.fig{position:relative;overflow:hidden;background:#090704;aspect-ratio:16/10;border-bottom:1px solid var(--line);display:block}.fig img{width:100%;height:100%;object-fit:cover;display:block}.fig:after{content:'';position:absolute;inset:0;background:linear-gradient(0deg,#09070499,transparent 50%);pointer-events:none}
.map-nome{color:var(--bone);font-size:26px;letter-spacing:1px;margin:0 0 6px}.map-nome a{color:inherit;text-decoration-color:var(--amber);text-underline-offset:4px}.fig-tag{position:absolute;z-index:2;left:0;bottom:12px;background:var(--amber);color:#131313;padding:4px 12px;font:700 12px/1.4 var(--font);letter-spacing:1px;max-width:94%}
.card.wide{flex-direction:row;margin-bottom:16px}.card.wide .fig{flex:0 0 44%;aspect-ratio:auto;min-height:250px;border-right:1px solid var(--line);border-bottom:0}.card.wide .card-body{justify-content:center;padding:24px}.lead{color:var(--bone)!important;font-size:20px}
.galeria{display:grid;gap:12px;margin:24px 0;grid-template-columns:repeat(auto-fill,minmax(170px,1fr))}.galeria .fig{aspect-ratio:4/3;border:1px solid var(--line)}.galeria .fig:hover{border-color:var(--lime)}
.meta{display:flex;flex-wrap:wrap;align-items:center;gap:5px 10px;font:400 11px/1.5 var(--mono);color:var(--bone-dim);text-transform:uppercase}.meta i{font-style:normal;color:var(--amber-dim)}.meta b{color:var(--amber)}.meta code{background:none;padding:0}
.tstat{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:12px;margin-bottom:20px}.tstat>div{border:1px solid var(--line);background:var(--panel);padding:16px 20px}.tstat b{color:var(--lime);font:400 40px/1 'Bebas Neue',Impact,sans-serif;display:block}.tstat span{font:400 11px/1.5 var(--mono);color:var(--bone-dim);text-transform:uppercase}
.tw{overflow-x:auto;border:1px solid var(--line);background:var(--panel)}table{border-collapse:collapse;width:100%}.tw table{min-width:640px}th{text-align:left;color:var(--bone-dim);font:400 11px/1.5 var(--mono);letter-spacing:1px;text-transform:uppercase;padding:12px;border-bottom:1px solid var(--line-hi);background:#090704}td{padding:10px 12px;border-bottom:1px solid var(--line);font-size:17px}tbody tr:hover{background:var(--amber-soft)}tbody tr.top{color:var(--ink)}.num{font-variant-numeric:tabular-nums;text-align:right}
.chip{display:inline-block;font:400 10px/1.5 var(--mono);text-transform:uppercase;border:1px solid var(--line-hi);padding:3px 8px;color:var(--bone-dim)}.chip.on{border-color:var(--lime);color:var(--lime)}
details{margin-bottom:10px;border:1px solid var(--line);padding:16px 20px;background:var(--panel)}summary{cursor:pointer;color:var(--bone);font-weight:700;font-size:19px}summary::marker{color:var(--lime)}details p{margin-top:10px}details[open]{border-left:3px solid var(--lime)}
.cta-row{display:flex;flex-wrap:wrap;gap:12px;margin-top:32px}.btn-cta{white-space:normal;max-width:100%}.btn-cta.btn-2{background:none;color:var(--bone);border-color:var(--line-hi)}input,select,button,textarea{font-family:inherit}
body>footer{border-top:1px solid var(--line);padding:18px 24px;background:#090704ed;font-size:14px;color:var(--bone-dim);text-align:center;line-height:1.8}body>footer a{color:var(--bone-dim);text-decoration:none}body>footer a:hover{color:var(--lime)}.foot-logo{display:none}
@media(max-width:1100px){body>header{gap:16px;flex-wrap:wrap}.game-nav{order:3;flex:1 0 100%;gap:20px}.brand-logo{height:58px}:root{--topo:128px}.btn-play{margin-left:auto}}
@media(max-width:600px){body>header{padding:8px 14px;gap:12px}.brand-logo{height:46px}:root{--topo:114px}.head-social{display:none}.game-nav a{font-size:14px;padding:8px 0}.btn-play{padding:10px 20px}main{padding:16px 14px 32px}.shell-toolbar{gap:10px;align-items:flex-start;margin-bottom:18px}.shell-tools{flex-direction:column;gap:8px;align-items:flex-end}.shell-location{max-width:50%;gap:5px}.phead{padding:42px 18px 24px;min-height:0}.kicker{left:18px;max-width:calc(100% - 36px)}.phead-art{width:100%;opacity:.16}.phead-in{max-width:100%}.sub{font-size:18px}.grid.c2,.grid.c3,.grid.cards{grid-template-columns:1fr}.card.wide{flex-direction:column}.card.wide .fig{flex:none;aspect-ratio:16/10;min-height:0;border-right:0}.card.wide .card-body{padding:20px}.tstat{gap:8px}.tstat>div{padding:12px}.tstat b{font-size:32px}.tstat span{font-size:10px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*:before,*:after{transition:none!important;animation:none!important}}
html[data-embedded="true"],html[data-embedded="true"] body{background:transparent;min-height:0}
html[data-embedded="true"] body>header,html[data-embedded="true"] body>footer,html[data-embedded="true"] .game-wallpaper,html[data-embedded="true"] .shell-toolbar{display:none}
html[data-embedded="true"] main{width:100%;max-width:none;padding:0 0 24px;margin:0}
html[data-embedded="true"] .phead{margin-top:0}
</style>
</head>
<body data-game-shell>
<a class="skip" href="#conteudo">{pageLang === 'en' ? 'Skip to content' : 'Pular para o conteúdo'}</a>
<div class="game-wallpaper" aria-hidden="true"></div>
<header>
  <a class="brand" href={playHref} aria-label={`${BRAND_FULL} - ${pageLang === 'en' ? 'game lobby' : 'lobby do jogo'}`}>
    <img class="brand-logo" src="/logo.png" width="651" height="526" alt={BRAND_FULL}>
  </a>
  <nav class="game-nav" aria-label={pageLang === 'en' ? 'Game navigation' : 'Navegação do jogo'}>
    {navigation.map(({ href, label, active }) => <a href={href} aria-current={active ? 'page' : undefined}>{label}</a>)}
  </nav>
  {/* O jogo é a rota `/`, e ele é o produto: o link pra ele é botão cheio, nunca
      um item de texto igual aos outros. É a hierarquia da referência. */}
  <a class="btn-play" href={playHref}>◂ {pageLang === 'en' ? 'PLAY' : 'JOGAR'}</a>
  <nav class="head-social" aria-label="Redes sociais">
    <a href={DISCORD_URL} rel="noopener" aria-label="Discord do CORO SOLTO">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.198.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"/></svg>
    </a>
    <a href={TELEGRAM_URL} rel="noopener" aria-label="Telegram do CORO SOLTO">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
    </a>
    <a href={GITHUB_URL} rel="noopener" aria-label="Código no GitHub">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
    </a>
  </nav>
</header>
<main id="conteudo" tabindex="-1">
  <div class="shell-toolbar">
    <div class="shell-location"><a href={playHref}>LOBBY</a><span aria-hidden="true"> / </span><span>{currentLabel}</span></div>
    <div class="shell-tools">
      {hreflangEn && <a href={pageLang === 'en' ? hreflangPt.replace(SITE, '') : hreflangEn.replace(SITE, '')} hreflang={pageLang === 'en' ? 'pt-BR' : 'en'} lang={pageLang === 'en' ? 'pt-BR' : 'en'}>{pageLang === 'en' ? 'PORTUGUÊS' : 'ENGLISH'}</a>}
      <a href={playHref}>◂ {pageLang === 'en' ? 'BACK TO GAME' : 'VOLTAR AO JOGO'}</a>
    </div>
  </div>
  {h1 && (
    <section class:list={['phead', { semarte: !heroImg }]}>
      {heroImg && <div class="phead-art" style={`--hero:url('${heroImg}');--heropos:${heroPos}`}></div>}
      {kicker && <span class="kicker">{kicker}</span>}
      <div class="phead-in">
        <h1>{h1}</h1>
        {temSub && <p class="sub"><slot name="sub" /></p>}
      </div>
    </section>
  )}
  <slot />
</main>
<footer>
  <a href="/" aria-label={`${BRAND_FULL} - página inicial`}>
    <img class="foot-logo" src="/logo.png" width="651" height="526" alt="" loading="lazy">
  </a>
  <div><strong style="color:var(--bone)">{BRAND_FULL}</strong> · {pageLang === 'en' ? 'Free browser FPS · No download required' : 'FPS gratuito de navegador · Sem download'}</div>
  <div>
    {/* separadores com `{' · '}` explícito: o espaço literal entre `·` e a
        próxima tag some na compilação e sai "Como jogar ·Changelog". */}
    <a href={pageLang === 'en' ? '/how-to-play' : '/como-jogar'}>{pageLang === 'en' ? 'How to play' : 'Como jogar'}</a>
    {RANKING_ON && <>{' · '}<a href="/ranking">Ranking</a></>}
    {' · '}<a href={pageLang === 'en' ? '/whats-new' : '/changelog'}>{pageLang === 'en' ? 'What’s new' : 'Novidades'}</a>
    {' · '}<a href={pageLang === 'en' ? '/about' : '/sobre'}>{pageLang === 'en' ? 'About' : 'Sobre'}</a>
    {' · '}<a href="/privacidade" hreflang="pt-BR">{pageLang === 'en' ? 'Privacy (pt-BR)' : 'Privacidade'}</a>
    {' · '}<a href="/excluir-dados" hreflang="pt-BR">{pageLang === 'en' ? 'Delete data (pt-BR)' : 'Excluir dados'}</a>
    {' · '}<a href="/termos" hreflang="pt-BR">{pageLang === 'en' ? 'Terms (pt-BR)' : 'Termos de uso'}</a>
    {' · '}<a href={GITHUB_URL} rel="noopener">Código (AGPL-3.0)</a>
    {pairedEn && (
      <>{' · '}<a href={pairedEn} hreflang="en" lang="en">English</a></>
    )}
    {pairedPt && (
      <>{' · '}<a href={pairedPt} hreflang="pt-BR" lang="pt-BR">Português</a></>
    )}
  </div>
</footer>

</body>
</html>
