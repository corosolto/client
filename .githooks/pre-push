#!/usr/bin/env bash
# Roda ANTES do push o que hoje só falha depois: no CI, ou na revisão.
#
# O QUE ELE EVITA, E O QUE NÃO EVITA
# Evita a ida-e-volta MECÂNICA: bloco gerado desatualizado, ARCH.md velho, travessão em
# src/, sintaxe, contrato de mapa, trailer `Agent:` faltando. Foi essa classe que deixou
# `pr-fast` vermelho em toda PR aberta por um dia inteiro.
#
# NÃO evita comentário de revisor de IA. Greptile aponta julgamento — cláusula que
# promete mais do que mede, caminho não validado, história de investigação colada no
# código. Script local não substitui isso, e prometer que substitui seria a mesma
# mentira que a régua que não morde. O que fecha esse lado é bloquear merge com fio
# aberto (ver docs/quality-gates.md), não um hook.
#
# Pular: `git push --no-verify` (ou PREPUSH=0). A seleção local roda o núcleo e as
# suites do diff; caminho desconhecido ou transversal cai no check:deploy completo.
set -uo pipefail
[ "${PREPUSH:-1}" = "0" ] && exit 0

remoto="$1"
RAIZ=$(git rev-parse --show-toplevel)
falhas=()
t0=$(date +%s)

# TODO PUSH VIRA PR (dono, 02/11): main e staging só recebem merge de PR revisado —
# push direto local é recusado aqui, barato, antes de qualquer gate. O merge do PR
# (botão do GitHub) não passa por este hook, então quem mergeia segue com o
# estraga-codigo e o CI na frente. Skill do agente: ~/.agents/skills/pr-ate-o-merge/.
entrada=$(cat)
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/staging)
      echo "" >&2
      echo "  PUSH BLOQUEADO — ${remote_ref#refs/heads/} só recebe merge de PR revisado." >&2
      echo "    git switch -c feat/minha-mudanca && git push -u origin feat/minha-mudanca" >&2
      echo "    gh pr create   # e siga ~/.agents/skills/pr-ate-o-merge/ até o merge" >&2
      exit 1
      ;;
  esac
done <<< "$entrada"

echo "pre-push: núcleo + suites do diff via check:prepush (fallback: check:deploy; PREPUSH=0 pula)"

# Trailer `Agent:` em TODO commit que sobe: o commit-msg não roda em rebase nem em
# clone sem `npm run setup`. Merge que traz a main injeta história alheia no
# intervalo — `--not --remotes` só cobra o que o remoto AINDA não tem.
#
# `--no-merges` pelo mesmo motivo do dco_check.py/agente_check.py: merge não escreve
# linha, e o "Merge pull request #N" do botão do GitHub não aceita trailer. Sem isto o
# hook era MAIS ESTRITO que o portão que ele espelha — o CI aprovava e o hook barrava,
# e a única saída era `--no-verify`, que pula TODOS os portões, inclusive os que mordem.
# Visto na #642: commits d2eb269a (Merge pull request #528) e 2b943df5 (Merge pull
# request #625), os dois merges da própria main, barrando um push que o CI aprovou.
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  intervalo=$(git rev-list --no-merges "$local_sha" --not --remotes="$remoto")
  for sha in $intervalo; do
    if ! git show -s --format='%B' "$sha" | grep -Eqi '^Agent:[[:space:]]*[^[:space:]]'; then
      falhas+=("commit ${sha:0:8} sem trailer 'Agent:' — $(git show -s --format='%s' "$sha" | cut -c1-50)")
    fi
    # `Co-Authored-By:` de agente de IA: o commit-msg já recusa, mas ele não roda em
    # rebase nem em clone sem `npm run setup`, e `--no-verify` pula os dois. Mesma
    # lista do commit-msg e do CI — scripts/coautoria-ia.re, lida, não copiada.
    if ! linha=$(git show -s --format='%B' "$sha" | sh "$RAIZ/scripts/checa-coautoria-ia.sh" 2>&1 >/dev/null); then
      falhas+=("commit ${sha:0:8} com co-autoria de IA — ${linha%%$'\n'*}")
    fi
  done
done <<< "$entrada"

# package.json e version.js têm que concordar (o portão versao-bumpada cobra isso).
if [ -f package.json ] && [ -f public/js/version.js ]; then
  pj=$(node -pe 'require("./package.json").version' 2>/dev/null)
  vj=$(grep -o "VERSION = '[^']*'" public/js/version.js 2>/dev/null | cut -d"'" -f2)
  [ -n "$pj" ] && [ "$pj" != "$vj" ] && falhas+=("package.json ($pj) != version.js ($vj)")
fi

# UM PRE-PUSH POR MÁQUINA. O arquivo candidato já contém PID, idade e identidade do
# processo antes de `ln` publicar o hard link atomicamente; outro hook nunca observa
# um lock sem dono. A identidade do `ps` distingue PID reutilizado, e a idade máxima
# recupera um processo vivo mas travado. Diretórios antigos são aceitos na migração.
trava=/tmp/csbrasil-prepush.lock
candidato="${trava}.$$.$RANDOM"
assinatura=$(ps -p $$ -o lstart= 2>/dev/null)
criado=$(date +%s)
printf '%s\n%s\n%s\n' "$$" "$criado" "$assinatura" > "$candidato"
espera=0; minha=0

limpa_trava() {
  rm -f "$candidato"
  if [ "$minha" = 1 ] && [ -f "$trava" ]; then
    dono_atual=$(head -n1 "$trava" 2>/dev/null)
    assinatura_atual=$(tail -n1 "$trava" 2>/dev/null)
    [ "$dono_atual" = "$$" ] && [ "$assinatura_atual" = "$assinatura" ] && rm -f "$trava"
  fi
}
trap limpa_trava EXIT

while :; do
  if [ -d "$trava" ]; then
    dono=$(cat "$trava/pid" 2>/dev/null)
    if [ -z "$dono" ] || ! kill -0 "$dono" 2>/dev/null; then rm -rf "$trava"; continue; fi
  elif ln "$candidato" "$trava" 2>/dev/null; then
    minha=1
    rm -f "$candidato"
    break
  else
    dono=$(head -n1 "$trava" 2>/dev/null)
    criado_dono=$(head -n2 "$trava" 2>/dev/null | tail -n1)
    assinatura_dono=$(tail -n1 "$trava" 2>/dev/null)
    agora=$(date +%s)
    obsoleto=0
    if ! [[ "$dono" =~ ^[0-9]+$ && "$criado_dono" =~ ^[0-9]+$ ]]; then
      obsoleto=1
    elif ! kill -0 "$dono" 2>/dev/null; then
      obsoleto=1
    elif [ "$(ps -p "$dono" -o lstart= 2>/dev/null)" != "$assinatura_dono" ]; then
      obsoleto=1
    elif [ $((agora - criado_dono)) -ge 7200 ]; then
      obsoleto=1
    fi
    if [ "$obsoleto" = 1 ]; then rm -f "$trava"; continue; fi
  fi
  [ "$espera" -eq 0 ] && echo "pre-push: outro pre-push em andamento (pid ${dono:-?}); esperando a vez"
  if [ "$espera" -ge 2400 ]; then echo "pre-push: 40 min de espera; seguindo sem a trava"; break; fi
  sleep 10
  espera=$((espera + 10))
done

for portao in eval:mapcontrato check:prepush; do
  if ! PREPUSH_REMOTE="$remoto" PREPUSH_REFS="$entrada" npm run "$portao" --silent >/tmp/prepush-$$.log 2>&1; then
    # O motivo tem de ser a linha que REPROVOU. O padrão anterior incluía `error`
    # solto e casava com `eval:error-console verde: ...` — uma régua que PASSOU —
    # então o hook acusava o portão errado e mandava o dono caçar no lugar errado.
    # Aqui só marcador de reprovação; sem nenhum, o fim do log é mais honesto que
    # uma linha verde escolhida a esmo.
    motivo=$(grep -m1 -E '✗|REPROV|FALHA|VERMELHO|ERRO:|Error:' /tmp/prepush-$$.log | cut -c1-90)
    [ -z "$motivo" ] && motivo=$(tail -n1 /tmp/prepush-$$.log | cut -c1-90)
    falhas+=("$portao — $motivo")
  elif [ "$portao" = "check:prepush" ]; then
    grep '^pre-push: ' /tmp/prepush-$$.log || true
  fi
done
rm -f /tmp/prepush-$$.log

if [ ${#falhas[@]} -gt 0 ]; then
  echo ""
  echo "  PUSH BLOQUEADO — ${#falhas[@]} portão(ões) reprovando:"
  for f in "${falhas[@]}"; do echo "    x $f"; done
  echo ""
  echo "  docs/ARCH desatualizado:  npm run docs && node tools/gen-arch.mjs"
  echo "  trailer faltando:         git commit --amend --trailer 'Agent: <nome>'"
  echo "  pular mesmo assim:        git push --no-verify"
  exit 1
fi

echo "pre-push: ok ($(( $(date +%s) - t0 ))s)"
exit 0
