#!/bin/sh
set -eu

# Roda o check:deploy ANTES do push. Não é zelo: numa única sessão de agosto/2026,
# quatro pushes seguidos abriram CI vermelho em portão que roda em 15 s na máquina
# (docs:check duas vezes, arch:check e eval:shaderlog). O portão existia; ninguém
# rodava. Escape: PULAR_PORTAO=1 git push, e o CI continua sendo a rede de baixo.
#
# check:deploy e não check:fast de propósito: 16 passos determinísticos, sem browser
# e sem rede, contra 33. Portão que demora vira portão que se contorna.

if [ -n "${PULAR_PORTAO:-}" ]; then
  echo "pre-push: portão pulado por PULAR_PORTAO=1 — o CI ainda vai cobrar." >&2
  exit 0
fi

# Push que só apaga branch remota não tem nada para medir.
tem_commit=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] || tem_commit=1
done
[ "$tem_commit" = "1" ] || exit 0

echo "pre-push: rodando check:deploy (PULAR_PORTAO=1 pula)..."
if npm run --silent check:deploy; then
  exit 0
fi

echo "" >&2
echo "pre-push: portão vermelho — o push parou aqui em vez de no CI." >&2
echo "  Conserte, ou 'PULAR_PORTAO=1 git push' se você sabe por quê." >&2
exit 1
