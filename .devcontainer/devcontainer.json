{
  "name": "CORO SOLTO - CI local",
  "build": {
    "context": "..",
    "dockerfile": ".devcontainer/Dockerfile"
  },
  "remoteUser": "node",
  "remoteEnv": {
    "PLAYWRIGHT_BROWSERS_PATH": "/opt/pw-browsers",
    "CHROME_BIN": "/usr/local/bin/coro-solto-chromium"
  },
  "postCreateCommand": "node scripts/setup.mjs && node scripts/ci-local.mjs --diagnose",
  "forwardPorts": [4321, 8123]
}
