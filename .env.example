# Copie para `.env` (que é ignorado pelo git) e preencha.
# Na Vercel, os mesmos nomes vão em Settings → Environment Variables.
#
# NADA AQUI É OBRIGATÓRIO PARA RODAR O JOGO. Sem estas variáveis o site sobe
# igual: as rotas de ranking respondem 503 `not_configured` e as páginas
# mostram "ranking ainda não configurado". O jogo em si (public/) não usa
# nenhuma delas.

# ── Supabase ────────────────────────────────────────────────────────────────
# URL do projeto (https://<ref>.supabase.co).
SUPABASE_URL=

# Chave de SERVIÇO. Fica SÓ no servidor: ela ignora RLS e pode tudo.
# É lida em src/lib/supabase.ts e nunca é enviada ao browser.
# Se esta chave vazar, gire ela no dashboard do Supabase IMEDIATAMENTE.
SUPABASE_SERVICE_ROLE_KEY=

# Chave ANÔNIMA. É pública por design — vai pro browser via GET /api/config.
# A segurança dela vem das policies e dos grants por coluna
# (supabase/migrations/011), não de escondê-la.
SUPABASE_ANON_KEY=

# ── Pacote de áudio ─────────────────────────────────────────────────────────
# Zip com public/audio/. Sem ele o jogo usa sons sintetizados (fallback).
# O default do scripts/fetch-audio.sh é a Release audio-pack-v1 do repositório.
AUDIO_PACK_URL=

# ── Google Search Console ───────────────────────────────────────────────────
# Conteúdo do meta tag de verificação (Search Console → Adicionar propriedade →
# domínio → método "Tag HTML"). Sem isso o site sobe igual — só não emite a
# <meta name="google-site-verification">.
GOOGLE_SITE_VERIFICATION=

# ── Geração de arte (só para as ferramentas de tools/, nunca para o jogo) ────
# Nenhuma destas é lida pelo browser: elas existem para os scripts que GERAM
# asset e param aí. O arquivo que vai pro commit é o resultado, não a chave.
#
# OpenRouter — arte 2D por texto/referência: `tools/gen-image.mjs`.
# É o que dá o acabamento realista por cima do render do modelo: o frame que sai
# de `tools/gen-char-video.mjs` entra como `--ref`, e a referência é o que trava
# a identidade do personagem. Sem esta chave o pipeline degrada para o render
# puro do GLB — que já é fiel, só não tem o tratamento realista por cima.
# ATENÇÃO: OpenRouter NÃO gera vídeo (nenhum modelo do catálogo emite vídeo);
# ele gera IMAGEM. O movimento vem do render do GLB, não do modelo generativo.
OPENROUTER_API_KEY=

# Tripo / Meshy — geração e rigging de modelo 3D: `tools/gen-asset.mjs`.
TRIPO_API_KEY=
MESHY_API_KEY=

# ── Apoio / doações ─────────────────────────────────────────────────────────
# Campanha brasileira no MeApoia (Pix). Válida para /apoie e para o menu do jogo.
PUBLIC_SUPPORT_URL_BR=https://meapoia.com/vaquinhas/ajude-a-manter-o-coro-solto-online
# Página internacional de apoio.
PUBLIC_SUPPORT_URL_INTL=https://ko-fi.com/corosolto
