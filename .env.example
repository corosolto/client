# Copie para `.env` (que é ignorado pelo git) e preencha.
# Na Vercel, os mesmos nomes vão em Settings → Environment Variables.
#
# NADA AQUI É OBRIGATÓRIO PARA RODAR O JOGO. Sem estas variáveis o site sobe
# igual: as rotas de ranking respondem 503 `not_configured` e as páginas
# mostram "ranking ainda não configurado". O jogo em si (public/) não usa
# nenhuma delas.

# ── Supabase ────────────────────────────────────────────────────────────────
# URL do projeto (https://<ref>.supabase.co).
SUPABASE_URL=

# Chave de SERVIÇO. Fica SÓ no servidor: ela ignora RLS e pode tudo.
# É lida em src/lib/supabase.ts e nunca é enviada ao browser.
# Se esta chave vazar, gire ela no dashboard do Supabase IMEDIATAMENTE.
SUPABASE_SERVICE_ROLE_KEY=

# Chave ANÔNIMA. É pública por design — vai pro browser via GET /api/config.
# A segurança dela vem das policies e dos grants por coluna
# (supabase/migrations/011), não de escondê-la.
SUPABASE_ANON_KEY=

# ── Pacote de áudio ─────────────────────────────────────────────────────────
# Zip com public/audio/. Sem ele o jogo usa sons sintetizados (fallback).
# O default do scripts/fetch-audio.sh é a Release audio-pack-v1 do repositório.
AUDIO_PACK_URL=

# ── Google Search Console ───────────────────────────────────────────────────
# Conteúdo do meta tag de verificação (Search Console → Adicionar propriedade →
# domínio → método "Tag HTML"). Sem isso o site sobe igual — só não emite a
# <meta name="google-site-verification">.
GOOGLE_SITE_VERIFICATION=

# ── Apoio / doações ─────────────────────────────────────────────────────────
# URL da campanha MeApoia depois que ela for criada. Sem ela, a página aponta
# temporariamente para a tela de criação da campanha.
PUBLIC_SUPPORT_URL_BR=https://meapoia.com/vaquinhas/ajude-a-manter-o-coro-solto-online
# Plataforma internacional (troque quando a conta/página estiver pronta).
PUBLIC_SUPPORT_URL_INTL=https://ko-fi.com
